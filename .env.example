# ─────────────────────────────────────────────────────────────
# PulseRival — copiá este archivo a ".env" y llená lo que uses.
# El sistema funciona en modo demo SIN ninguna de estas claves.
# ─────────────────────────────────────────────────────────────

# --- Base de datos (dejalo así salvo que quieras otra ruta) ---
PULSERIVAL_DB=datos/pulserival.db

# --- Recolección de anuncios (Apify) ---
# Se saca en https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Modelos de IA ---
# Groq (tier gratuito): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (tenés ~$9 de crédito): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Envío de email ---
# Opción A (recomendada): Resend -> https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_REMITENTE="PulseRival <reportes@tudominio.com>"
EMAIL_RESPONDER_A=
# Opción B: cualquier SMTP (Gmail, Zoho, etc.)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- Fuente complementaria: API oficial de Meta Ad Library ---
# Solo sirve para anuncios políticos/sociales o entregados en UE/UK. Ver docs/03.
META_AD_LIBRARY_TOKEN=
