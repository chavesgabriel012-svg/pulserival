# ─────────────────────────────────────────────────────────────
# PulseRival — copiá este archivo a ".env" y llená lo que uses.
# El sistema funciona en modo demo SIN ninguna de estas claves.
# ─────────────────────────────────────────────────────────────

# --- Base de datos (dejalo así salvo que quieras otra ruta) ---
PULSERIVAL_DB=datos/pulserival.db

# --- Recolección de anuncios (Apify) ---
# Se saca en https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Modelos de IA ---
# Groq (tier gratuito): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (tenés ~$9 de crédito): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Envío de email ---
# Opción A (recomendada): Resend -> https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_REMITENTE="PulseRival <reportes@tudominio.com>"
EMAIL_RESPONDER_A=
# Opción B: cualquier SMTP (Gmail, Zoho, etc.)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- Fuente complementaria: API oficial de Meta Ad Library ---
# Solo sirve para anuncios políticos/sociales o entregados en UE/UK. Ver docs/03.
META_AD_LIBRARY_TOKEN=

# --- Servidor web (landing + alta + cobro) ---
# Dónde vive la base. En un servidor con disco persistente apuntá acá:
#   PULSERIVAL_DB=/datos/pulserival.db
# NO funciona en hosting serverless (Vercel, Netlify Functions): ahí el
# sistema de archivos es efímero y la base se borra entre peticiones.

# 'simulado' (por defecto) = el checkout activa la cuenta sin cobrar nada.
# 'real' = el checkout manda a la pasarela y solo su webhook puede activar.
PULSERIVAL_COBRO=simulado

# Verificar con el scraper si los competidores tienen anuncios al darse de
# alta. Apagado por defecto: cada verificación cuesta por anuncio y un
# formulario público es una forma de que un desconocido gaste su crédito.
PULSERIVAL_VERIFICAR_ALTA=0
