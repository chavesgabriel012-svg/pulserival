<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Entrar · {{ marca }}</title>
<link rel="icon" href="/marca/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style>
  body { margin:0; background:#141312; color:#F4F2EE; min-height:100vh; display:grid;
    place-items:center; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .caja { width:340px; padding:0 24px; }
  img { display:block; height:26px; margin:0 0 36px; }
  h1 { font-family:'Schibsted Grotesk',system-ui,sans-serif; font-size:22px;
       letter-spacing:-.02em; margin:0 0 22px; font-weight:700; }
  input { width:100%; padding:13px 15px; border:1px solid #3A3834; background:#1E1D1B; color:#F4F2EE; border-radius:6px;
    font-family:inherit; font-size:15px; }
  input:focus { outline:none; border-color:#EF5B36; }
  button { width:100%; margin-top:16px; padding:13px; background:#DD4115; color:#FFFFFF;
    border:1.5px solid #DD4115; border-radius:6px;
    font-family:'Schibsted Grotesk',system-ui,sans-serif; font-size:16px;
    font-weight:700; cursor:pointer; transition:background .2s; }
  button:hover { background:#EF5B36; border-color:#EF5B36; }
  .error { border:1px solid #EF5B36; color:#EF5B36; padding:12px 14px; font-size:14px;
           margin:0 0 18px; border-radius:6px; }
</style>
</head>
<body>
<div class="caja">
  <img src="/marca/logo-negativo.svg" alt="{{ marca }}">
  <h1>Panel de revisión</h1>
  {% if error %}<div class="error">{{ error }}</div>{% endif %}
  <form method="post" action="{{ url_for('panel.entrar_post') }}">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="volver" value="{{ volver }}">
    <input type="password" name="clave" placeholder="Contraseña" autofocus required
           autocomplete="current-password">
    <button type="submit">Entrar</button>
  </form>
</div>
</body>
</html>
