<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Entrar · {{ marca }}</title>
<style>
  body { margin:0; background:#000; color:#fff; min-height:100vh; display:grid;
    place-items:center; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .caja { width:340px; padding:0 24px; }
  img { display:block; height:22px; margin:0 0 34px; }
  h1 { font-size:13px; text-transform:uppercase; letter-spacing:1.6px; margin:0 0 20px;
       font-weight:600; }
  input { width:100%; padding:12px 14px; border:1px solid #444; background:#111; color:#fff;
    font-family:inherit; font-size:15px; }
  input:focus { outline:none; border-color:#fff; }
  button { width:100%; margin-top:14px; padding:12px; background:#fff; color:#000;
    border:2px solid #fff; font-family:inherit; font-size:15px; font-weight:600; cursor:pointer; }
  button:hover { background:#000; color:#fff; }
  .error { border:1px solid #fff; padding:11px 13px; font-size:13px; margin:0 0 18px; }
</style>
</head>
<body>
<div class="caja">
  {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="{{ marca }}">{% endif %}
  <h1>Panel de revisión</h1>
  {% if error %}<div class="error">{{ error }}</div>{% endif %}
  <form method="post" action="{{ url_for('panel.entrar_post') }}">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="volver" value="{{ volver }}">
    <input type="password" name="clave" placeholder="Contraseña" autofocus required
           autocomplete="current-password">
    <button type="submit">Entrar</button>
  </form>
</div>
</body>
</html>
