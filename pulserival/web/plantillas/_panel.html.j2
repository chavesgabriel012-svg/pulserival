<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block titulo %}Panel · {{ marca }}{% endblock %}</title>
<meta name="theme-color" content="#141312">
<link rel="icon" href="/marca/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/marca/favicon.ico" sizes="any">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* Los tokens de la identidad de marca, igual que las páginas públicas. Acá
     el ancho es mayor porque hay que leer un reporte al lado de sus problemas.
     El naranja tiene un trabajo concreto: marcar lo que pide atención. */
  :root {
    --tinta:#141312; --papel:#F4F2EE; --blanco:#FFFFFF;
    --pulso:#DD4115; --pulso-oscuro:#EF5B36; --pulso-texto:#B22800;
    --piedra:#8A857D; --gris-texto:#6B665E; --linea:#D9D5CE;
    --texto-osc-2:#B5B0A6; --radio:6px;
    --display:'Schibsted Grotesk',system-ui,-apple-system,sans-serif;
    --cuerpo:'Source Serif 4',Georgia,serif;
    --mono:'IBM Plex Mono',ui-monospace,monospace;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--papel); color:var(--tinta); line-height:1.55;
    font-family:var(--cuerpo); font-size:16px; -webkit-font-smoothing:antialiased; }
  .env { max-width:1180px; margin:0 auto; padding:0 28px; }
  a { color:var(--tinta); }
  header { background:var(--tinta); padding:14px 0; }
  header .env { display:flex; align-items:center; gap:28px; }
  header img { display:block; height:24px; width:auto; }
  header nav { display:flex; gap:22px; margin-left:auto; align-items:center; }
  header nav a, header nav button { color:var(--papel); text-decoration:none;
    font-family:var(--display); font-size:13.5px; font-weight:500; background:none;
    border:none; cursor:pointer; padding:0; opacity:.8; }
  header nav a:hover, header nav button:hover { opacity:1; }
  header nav a:hover, header nav button:hover { text-decoration:underline; }
  .cuerpo { padding:40px 0 80px; }
  h1 { font-family:var(--display); font-size:26px; line-height:1.15; margin:0 0 6px;
       letter-spacing:-.02em; font-weight:700; }
  h2 { font-family:var(--mono); font-size:11.5px; text-transform:uppercase;
       letter-spacing:.1em; margin:38px 0 14px; padding-bottom:7px;
       border-bottom:2px solid var(--pulso); display:inline-block;
       color:var(--pulso-texto); font-weight:500; }
  h3 { font-family:var(--display); font-size:16px; margin:22px 0 8px; font-weight:600; }
  .sub { color:var(--gris-texto); font-size:14px; margin:0 0 4px; }
  .btn { display:inline-block; background:var(--pulso); color:var(--blanco);
    text-decoration:none; padding:11px 22px; font-family:var(--display);
    font-weight:700; font-size:14.5px; border:1.5px solid var(--pulso);
    border-radius:var(--radio); cursor:pointer; transition:background .2s; }
  .btn:hover { background:var(--pulso-oscuro); border-color:var(--pulso-oscuro); }
  .btn.alt { background:transparent; color:var(--tinta); border-color:var(--piedra); }
  .btn.alt:hover { background:var(--tinta); border-color:var(--tinta); color:var(--papel); }
  .btn.chico { padding:7px 14px; font-size:13px; }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  td, th { text-align:left; padding:10px 14px 10px 0; border-bottom:1px solid var(--linea);
           vertical-align:top; }
  th { color:var(--piedra); font-family:var(--mono); font-weight:500; font-size:11px;
       text-transform:uppercase; letter-spacing:.1em;
       border-bottom:1px solid var(--linea); }
  td.num, th.num { text-align:right; padding-right:26px; white-space:nowrap;
                   font-variant-numeric:tabular-nums; }
  td.num:last-child, th.num:last-child { padding-right:0; }
  .marca { display:inline-block; border:1px solid var(--piedra); padding:2px 8px;
    font-family:var(--mono); font-size:10.5px; text-transform:uppercase;
    letter-spacing:.09em; white-space:nowrap; border-radius:3px;
    color:var(--gris-texto); }
  .marca.lleno { background:var(--pulso); border-color:var(--pulso);
                 color:var(--blanco); }
  .nota { background:var(--blanco); padding:15px 17px; font-size:15px;
          color:var(--gris-texto); border-left:3px solid var(--pulso);
          border-radius:0 var(--radio) var(--radio) 0; margin:18px 0; }
  .aviso { border:1.5px solid var(--pulso); background:var(--blanco); padding:16px 18px;
           font-size:15px; margin:0 0 24px; border-radius:var(--radio); }
  .aviso strong { font-family:var(--mono); text-transform:uppercase;
                  letter-spacing:.1em; font-size:11px; display:block;
                  margin-bottom:7px; color:var(--pulso-texto); font-weight:500; }
  ul.limpia { list-style:none; padding:0; margin:0; }
  ul.limpia li { padding:7px 0; border-bottom:1px solid var(--linea); font-size:14px; }
  .cols { display:grid; grid-template-columns:1fr 340px; gap:40px; align-items:start; }
  @media (max-width:900px) { .cols { grid-template-columns:1fr; } }
  textarea { width:100%; min-height:520px; font-family:var(--mono);
    font-size:13px; line-height:1.7; padding:16px; border:1px solid var(--linea);
    background:var(--blanco); color:var(--tinta); border-radius:var(--radio);
    text-transform:none; letter-spacing:0; }
  input[type=text], input[type=password], select { width:100%; padding:11px 13px;
    border:1px solid var(--linea); font-family:var(--cuerpo); font-size:15px;
    background:var(--blanco); border-radius:var(--radio); color:var(--tinta); }
  input:focus, select:focus, textarea:focus { outline:none; border-color:var(--pulso);
    box-shadow:0 0 0 3px rgba(221,65,21,.16); }
  label { display:block; font-family:var(--mono); font-size:11px;
    text-transform:uppercase; letter-spacing:.1em; color:var(--piedra);
    margin:16px 0 6px; }
  .campos { display:grid; gap:0; }
  iframe { width:100%; height:760px; border:1px solid var(--linea); background:#fff; }
  .vacio { color:var(--piedra); font-size:16px; padding:28px 0; }
  details summary { cursor:pointer; font-family:var(--mono); font-size:11.5px;
    text-transform:uppercase; letter-spacing:.09em; padding:11px 0;
    border-bottom:1px solid var(--linea); color:var(--gris-texto); }
  details summary:hover { color:var(--pulso-texto); }
  .md h1, .md h2, .md h3 { text-transform:none; letter-spacing:0; border:none; display:block; }
  .md h2 { font-size:19px; margin:26px 0 10px; }
  .md { font-size:15px; }
</style>
</head>
<body>
<header><div class="env">
  <a href="{{ url_for('panel.bandeja') }}" style="display:flex;align-items:center;">
    <img src="/marca/logo-negativo.svg" alt="{{ marca }}">
  </a>
  <nav>
    <a href="{{ url_for('panel.bandeja') }}">Bandeja</a>
    <a href="{{ url_for('panel.gasto') }}">Gasto</a>
    {% if csrf %}
    <form method="post" action="{{ url_for('panel.salir') }}" style="display:inline;">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <button type="submit">Salir</button>
    </form>
    {% endif %}
  </nav>
</div></header>
<div class="env cuerpo">{% block contenido %}{% endblock %}</div>
</body>
</html>
