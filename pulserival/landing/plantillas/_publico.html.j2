<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titulo %}{{ marca }}{% endblock %}</title>
<meta name="description" content="{{ subtitulo }}">
<meta name="theme-color" content="#141312">
<meta property="og:title" content="{{ self.titulo() }}">
<meta property="og:description" content="{{ subtitulo }}">
<meta property="og:type" content="website">
<meta property="og:image" content="{{ marca_url }}/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ marca_url }}/favicon.ico" sizes="any">
<link rel="icon" href="{{ marca_url }}/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ marca_url }}/apple-touch-icon.png">
<link rel="manifest" href="{{ marca_url }}/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
{# La clase `js` se pone ANTES de que el navegador pinte nada. Sin esto, la
   animación de aparición tendría que esconder el contenido desde el CSS, y
   quien tenga JavaScript apagado se quedaría con una página en blanco. #}
<script>document.documentElement.classList.add('js');</script>
<style>
  /* Tokens de la identidad de marca (assets/tokens.json de la entrega).
     Regla de color: papel y tinta hacen el 95 % del trabajo. El naranja Pulso
     aparece poco —el ojo del logo, el botón principal, las marcas de cambio—
     y nunca en degradado. */
  :root{
    --tinta:#141312;        /* texto principal, fondos oscuros */
    --papel:#F4F2EE;        /* fondo principal */
    --blanco:#FFFFFF;       /* tarjetas sobre papel */
    --pulso:#DD4115;        /* acento sobre claro */
    --pulso-oscuro:#EF5B36; /* acento sobre fondos oscuros */
    --pulso-texto:#B22800;  /* acento en texto pequeño sobre claro (contraste AA) */
    --piedra:#8A857D;       /* bordes fuertes; nunca texto pequeño */
    --gris-texto:#6B665E;   /* texto secundario sobre papel */
    --linea:#D9D5CE;        /* divisores sobre papel */
    --desk:#1E1D1B;         /* fondo oscuro de secciones */
    --linea-osc:#3A3834;
    --texto-osc-2:#B5B0A6;
    --radio:6px;

    --display:'Schibsted Grotesk',system-ui,-apple-system,sans-serif;
    --cuerpo:'Source Serif 4',Georgia,serif;
    --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;
    --curva:cubic-bezier(.22,.7,.3,1);
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body {
    margin:0; background:var(--papel); color:var(--tinta);
    font-family:var(--cuerpo); font-size:17px; line-height:1.5;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .env { max-width:1080px; margin:0 auto; padding:0 28px; }
  a { color:var(--tinta); }
  h1, h2, h3, .display { font-family:var(--display); font-weight:700;
                         letter-spacing:-.02em; line-height:1.1; }
  .mono { font-family:var(--mono); font-size:12px; letter-spacing:.1em;
          text-transform:uppercase; }

  /* -- aparecer al bajar --------------------------------------- */
  .js .sube { opacity:0; transform:translateY(22px); }
  .js .sube.visto {
    opacity:1; transform:none;
    transition:opacity .75s var(--curva), transform .75s var(--curva);
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior:auto; }
    .js .sube, .js .sube.visto { opacity:1; transform:none; transition:none; }
  }

  /* -- encabezado ---------------------------------------------- */
  header {
    background:var(--tinta); position:sticky; top:0; z-index:20;
    transition:box-shadow .3s var(--curva);
  }
  header.pegado { box-shadow:0 1px 0 var(--linea-osc); }
  /* El nombre del producto, hecho movimiento: un pulso naranja cruza el borde
     de abajo del encabezado y despues no pasa nada por varios segundos. El
     encabezado esta siempre a la vista, asi que el latido es corto y muy
     espaciado; algo moviendose sin parar arriba de todo cansa y distrae de
     lo que se esta leyendo.
     La pista recorta el desborde horizontal sin tocar el encabezado, que
     necesita dejar salir su sombra cuando se pega. */
  header .pista {
    position:absolute; left:0; right:0; bottom:0; height:1.5px;
    overflow:hidden; pointer-events:none;
  }
  header .pulso {
    display:block; width:96px; height:100%; background:var(--pulso-oscuro);
    opacity:0; will-change:transform;
    /* Lineal a proposito: la curva de la pagina frena al final y dejaba
       el pulso arrastrandose contra el borde derecho. Un latido cruza
       parejo. */
    animation:cruza-el-pulso 11s linear 1.5s infinite;
  }
  @keyframes cruza-el-pulso {
    0%   { transform:translateX(-96px); opacity:0; }
    3%   { opacity:.9; }
    17%  { opacity:.9; }
    21%  { transform:translateX(100vw); opacity:0; }
    100% { transform:translateX(100vw); opacity:0; }
  }
  @media (prefers-reduced-motion: reduce) {
    header .pista { display:none; }
  }
  header .env { display:flex; align-items:center; gap:32px; height:66px; }
  .marca-enlace {
    display:flex; align-items:center; text-decoration:none;
    transition:opacity .2s var(--curva);
  }
  .marca-enlace:hover { opacity:.75; }
  .marca-enlace img { display:block; height:26px; width:auto; }
  .marca-enlace span { color:var(--papel); font-family:var(--display);
                       font-weight:800; letter-spacing:.4px; font-size:19px; }
  header nav { margin-left:auto; display:flex; gap:28px; align-items:center; }
  header nav a {
    color:var(--papel); text-decoration:none; font-family:var(--display);
    font-size:14px; font-weight:500; opacity:.78;
    transition:opacity .2s var(--curva); position:relative; padding:4px 0;
  }
  header nav a:after {
    content:""; position:absolute; left:0; bottom:0; height:1.5px; width:100%;
    background:var(--pulso-oscuro); transform:scaleX(0); transform-origin:left;
    transition:transform .3s var(--curva);
  }
  header nav a:hover { opacity:1; }
  header nav a:hover:after { transform:scaleX(1); }
  header nav a.cta {
    opacity:1; background:var(--pulso); color:var(--blanco); padding:9px 20px;
    font-weight:700; border-radius:var(--radio);
    transition:background .25s var(--curva);
  }
  header nav a.cta:after { display:none; }
  header nav a.cta:hover { background:var(--pulso-oscuro); }
  @media (max-width:760px) {
    header nav a.oculto { display:none; }
    .marca-enlace img { height:22px; }
  }

  /* -- botones ------------------------------------------------- */
  .btn {
    display:inline-block; background:var(--pulso); color:var(--blanco);
    text-decoration:none; padding:15px 30px; font-family:var(--display);
    font-weight:700; font-size:16px; border:1.5px solid var(--pulso);
    border-radius:var(--radio); cursor:pointer; letter-spacing:-.01em;
    transition:background .25s var(--curva), border-color .25s var(--curva),
               transform .25s var(--curva), box-shadow .25s var(--curva);
  }
  .btn:hover {
    background:var(--pulso-oscuro); border-color:var(--pulso-oscuro);
    transform:translateY(-2px); box-shadow:0 8px 20px rgba(221,65,21,.22);
  }
  .btn.alt {
    background:transparent; color:var(--tinta); border-color:var(--piedra);
  }
  .btn.alt:hover {
    background:var(--tinta); border-color:var(--tinta); color:var(--papel);
    box-shadow:0 8px 20px rgba(20,19,18,.16);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn { transition:background .2s; }
    .btn:hover { transform:none; box-shadow:none; }
  }

  /* -- secciones ----------------------------------------------- */
  section { padding:88px 0; }
  section + section { border-top:1px solid var(--linea); }
  .rotulo {
    font-family:var(--mono); font-size:12px; text-transform:uppercase;
    letter-spacing:.1em; color:var(--pulso-texto); margin:0 0 16px; font-weight:500;
  }
  h2 { font-size:36px; margin:0 0 18px; max-width:24ch; }
  .entrada { font-size:18px; color:var(--gris-texto); max-width:64ch; margin:0 0 48px;
             line-height:1.5; }

  /* -- formularios --------------------------------------------- */
  .campo label { display:block; font-family:var(--display); font-size:14px;
                 font-weight:600; margin-bottom:7px; }
  .campo .ayuda { font-size:15px; color:var(--gris-texto); margin-bottom:9px; }
  input, textarea, select {
    width:100%; padding:13px 14px; border:1px solid var(--linea); font-size:16px;
    font-family:var(--cuerpo); background:var(--blanco); color:var(--tinta);
    border-radius:var(--radio);
    transition:border-color .2s var(--curva), box-shadow .2s var(--curva);
  }
  input::placeholder, textarea::placeholder { color:var(--piedra); }
  input:focus, textarea:focus, select:focus {
    outline:none; border-color:var(--pulso); box-shadow:0 0 0 3px rgba(221,65,21,.16);
  }
  textarea { min-height:112px; resize:vertical; line-height:1.55; }
  /* Los dos campos de una fila alinean sus casillas abajo: si una etiqueta
     ocupa dos lineas y la otra una, sin esto las casillas quedan a distinta
     altura y la fila se lee torcida. */
  .fila { display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:stretch; }
  .fila > .campo { display:flex; flex-direction:column; }
  .fila > .campo > input, .fila > .campo > select { margin-top:auto; }
  .nota { background:var(--blanco); padding:17px 19px; font-size:15px;
          color:var(--gris-texto); border-left:3px solid var(--pulso);
          border-radius:0 var(--radio) var(--radio) 0; line-height:1.55; }

  /* La linea de arriba separa el pie del cierre: los dos son oscuros y sin
     ella se leen como un solo bloque que no termina nunca. */
  footer { background:var(--tinta); color:var(--texto-osc-2); padding:56px 0 64px;
           font-size:15px; border-top:1px solid var(--linea-osc); }
  footer a { color:var(--papel); }
  footer .pie-marca img { height:24px; width:auto; display:block; margin-bottom:20px; }
  footer p { margin:0 0 11px; max-width:74ch; line-height:1.6; }
  footer .legal { font-family:var(--mono); font-size:11.5px; letter-spacing:.06em;
                  color:var(--piedra); margin-top:24px; text-transform:none; }

  @media (max-width:900px) { section { padding:62px 0; } h2 { font-size:29px; } }
  @media (max-width:640px) {
    .fila { grid-template-columns:1fr; }
    .env { padding:0 20px; }
  }
  {% block estilos %}{% endblock %}
</style>
</head>
<body>

<header id="cabecera">
  <span class="pista" aria-hidden="true"><span class="pulso"></span></span>
  <div class="env">
    <a class="marca-enlace" href="{{ inicio_url|default('/') }}" aria-label="{{ marca }}, ir al inicio">
      <img src="{{ marca_url }}/logo-negativo.svg" alt="{{ marca }}">
    </a>
    <nav>{% block navegacion %}{% endblock %}</nav>
  </div>
</header>

{% block contenido %}{% endblock %}

<footer>
  <div class="env">
    <div class="pie-marca">
      <img src="{{ marca_url }}/logo-negativo.svg" alt="{{ marca }}">
    </div>
    <p>
      Fuentes: Biblioteca de Anuncios de Meta y Centro de Transparencia de
      Anuncios de Google, ambas públicas y abiertas a cualquiera.
    </p>
    <p>
      Las plataformas no publican inversión, alcance ni clics de los anuncios
      comerciales, de modo que los reportes no los incluyen ni los estiman.
    </p>
    <p class="legal">{{ marca }}{% if dominio %} &middot; {{ dominio }}{% endif %}</p>
  </div>
</footer>

<script>
// Aparecer al bajar. Un observador por página, sin librerías: cuando un
// bloque entra en pantalla se le agrega `visto` y el CSS hace el resto.
// Se deja de observar apenas aparece: la animación es de entrada, no de ida
// y vuelta, y volver a esconder algo que ya se leyó marea.
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var bloques = document.querySelectorAll('.sube');

  if (reduce.matches || !('IntersectionObserver' in window)) {
    for (var i = 0; i < bloques.length; i++) { bloques[i].classList.add('visto'); }
  } else {
    var obs = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) {
        if (!e.isIntersecting) { return; }
        e.target.classList.add('visto');
        obs.unobserve(e.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    for (var j = 0; j < bloques.length; j++) { obs.observe(bloques[j]); }
  }

  // Lo que ya está en pantalla al cargar aparece enseguida, sin esperar a
  // que la persona baje: si no, la portada arranca vacía.
  requestAnimationFrame(function () {
    var alto = window.innerHeight;
    for (var k = 0; k < bloques.length; k++) {
      if (bloques[k].getBoundingClientRect().top < alto * 0.9) {
        bloques[k].classList.add('visto');
      }
    }
  });

  var cab = document.getElementById('cabecera');
  var marcar = function () { cab.classList.toggle('pegado', window.scrollY > 8); };
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });
})();
</script>
{% block guion %}{% endblock %}
</body>
</html>
