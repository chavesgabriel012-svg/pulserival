<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titulo %}{{ marca }}{% endblock %}</title>
<meta name="description" content="{{ subtitulo }}">
<meta property="og:title" content="{{ self.titulo() }}">
<meta property="og:description" content="{{ subtitulo }}">
<meta property="og:type" content="website">
{# La clase `js` se pone ANTES de que el navegador pinte nada. Sin esto, la
   animación de aparición tendría que esconder el contenido desde el CSS, y
   quien tenga JavaScript apagado se quedaría con una página en blanco. #}
<script>document.documentElement.classList.add('js');</script>
<style>
  /* Blanco y negro, sin excepciones. Lo que da jerarquía acá es el tamaño
     del texto, el aire y el movimiento: no hay color al que recurrir. */
  :root {
    --negro:#000; --tinta:#111; --gris:#5a5a5a; --tenue:#8d8d8d;
    --linea:#e6e6e6; --linea-fuerte:#000; --suave:#f7f7f7;
    --curva:cubic-bezier(.22,.7,.3,1);
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body {
    margin:0; background:#fff; color:var(--tinta);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    line-height:1.62; -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  .env { max-width:1080px; margin:0 auto; padding:0 28px; }
  a { color:var(--negro); }

  /* -- aparecer al bajar --------------------------------------- */
  /* Solo con JavaScript encendido, y solo si la persona no pidió menos
     movimiento. El observador les agrega `visto` cuando entran en pantalla. */
  .js .sube { opacity:0; transform:translateY(22px); }
  .js .sube.visto {
    opacity:1; transform:none;
    transition:opacity .75s var(--curva), transform .75s var(--curva);
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior:auto; }
    .js .sube, .js .sube.visto { opacity:1; transform:none; transition:none; }
  }

  /* -- encabezado ---------------------------------------------- */
  header {
    background:var(--negro); position:sticky; top:0; z-index:20;
    transition:box-shadow .3s var(--curva);
  }
  header.pegado { box-shadow:0 1px 0 rgba(255,255,255,.18); }
  header .env { display:flex; align-items:center; gap:32px; height:64px; }
  .marca-enlace {
    display:flex; align-items:center; text-decoration:none;
    transition:opacity .2s var(--curva);
  }
  .marca-enlace:hover { opacity:.72; }
  .marca-enlace img { display:block; height:22px; width:auto; }
  .marca-enlace span { color:#fff; font-weight:700; letter-spacing:.4px; font-size:18px; }
  header nav { margin-left:auto; display:flex; gap:28px; align-items:center; }
  header nav a {
    color:#fff; text-decoration:none; font-size:13.5px; letter-spacing:.2px;
    opacity:.72; transition:opacity .2s var(--curva); position:relative;
    padding:4px 0;
  }
  header nav a:after {
    content:""; position:absolute; left:0; bottom:0; height:1px; width:100%;
    background:#fff; transform:scaleX(0); transform-origin:left;
    transition:transform .3s var(--curva);
  }
  header nav a:hover { opacity:1; }
  header nav a:hover:after { transform:scaleX(1); }
  header nav a.cta {
    opacity:1; border:1px solid #fff; padding:8px 18px; font-weight:600;
    transition:background .25s var(--curva), color .25s var(--curva);
  }
  header nav a.cta:after { display:none; }
  header nav a.cta:hover { background:#fff; color:var(--negro); }
  @media (max-width:760px) { header nav a.oculto { display:none; } }

  /* -- botones ------------------------------------------------- */
  .btn {
    display:inline-block; background:var(--negro); color:#fff; text-decoration:none;
    padding:15px 30px; font-weight:600; font-size:15px; border:1.5px solid var(--negro);
    cursor:pointer; font-family:inherit; position:relative; overflow:hidden;
    transition:transform .25s var(--curva), box-shadow .25s var(--curva);
  }
  .btn:before {
    content:""; position:absolute; inset:0; background:#fff;
    transform:scaleY(0); transform-origin:bottom;
    transition:transform .3s var(--curva);
  }
  .btn span { position:relative; z-index:1; transition:color .25s var(--curva); }
  .btn:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.14); }
  .btn:hover:before { transform:scaleY(1); }
  .btn:hover span { color:var(--negro); }
  .btn.alt { background:#fff; color:var(--negro); }
  .btn.alt:before { background:var(--negro); }
  .btn.alt:hover span { color:#fff; }
  @media (prefers-reduced-motion: reduce) {
    .btn, .btn:before, .btn span { transition:none; }
    .btn:hover { transform:none; box-shadow:none; }
  }

  /* -- secciones ----------------------------------------------- */
  section { padding:84px 0; }
  section + section { border-top:1px solid var(--linea); }
  .rotulo {
    font-size:12px; text-transform:uppercase; letter-spacing:2.2px;
    color:var(--tenue); margin:0 0 16px; font-weight:600;
  }
  h2 { font-size:32px; line-height:1.18; margin:0 0 18px; letter-spacing:-.7px;
       font-weight:600; max-width:24ch; }
  .entrada { font-size:17px; color:#3d3d3d; max-width:64ch; margin:0 0 48px; }

  /* -- formularios --------------------------------------------- */
  .campo label { display:block; font-size:14px; font-weight:600; margin-bottom:7px; }
  .campo .ayuda { font-size:13.5px; color:var(--gris); font-weight:400; margin-bottom:9px; }
  input, textarea, select {
    width:100%; padding:13px 14px; border:1px solid #cfcfcf; font-size:15px;
    font-family:inherit; background:#fff; color:var(--tinta);
    transition:border-color .2s var(--curva), box-shadow .2s var(--curva);
  }
  input::placeholder, textarea::placeholder { color:#adadad; }
  input:focus, textarea:focus, select:focus {
    outline:none; border-color:var(--negro); box-shadow:inset 0 0 0 1px var(--negro);
  }
  textarea { min-height:112px; resize:vertical; line-height:1.6; }
  .fila { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .nota { background:var(--suave); padding:17px 19px; font-size:14px; color:#3d3d3d;
          border-left:2px solid var(--negro); }

  footer { background:var(--negro); color:#8d8d8d; padding:52px 0 60px; font-size:14px; }
  footer a { color:#fff; }
  footer .pie-marca { color:#fff; font-weight:700; letter-spacing:.4px; margin-bottom:16px;
                      font-size:16px; }
  footer p { margin:0 0 11px; max-width:74ch; line-height:1.7; }

  @media (max-width:900px) { section { padding:60px 0; } h2 { font-size:26px; } }
  @media (max-width:640px) {
    .fila { grid-template-columns:1fr; }
    .env { padding:0 20px; }
  }
  {% block estilos %}{% endblock %}
</style>
</head>
<body>

<header id="cabecera">
  <div class="env">
    <a class="marca-enlace" href="{{ inicio_url|default('/') }}" aria-label="{{ marca }}, ir al inicio">
      {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="{{ marca }}">
      {% else %}<span>{{ marca }}</span>{% endif %}
    </a>
    <nav>{% block navegacion %}{% endblock %}</nav>
  </div>
</header>

{% block contenido %}{% endblock %}

<footer>
  <div class="env">
    <div class="pie-marca">{{ marca }}{% if dominio %} &middot; {{ dominio }}{% endif %}</div>
    <p>
      Fuentes: Biblioteca de Anuncios de Meta y Centro de Transparencia de
      Anuncios de Google, ambas públicas y abiertas a cualquiera.
    </p>
    <p>
      Las plataformas no publican inversión, alcance ni clics de los anuncios
      comerciales, de modo que los reportes no los incluyen ni los estiman.
    </p>
  </div>
</footer>

<script>
// Aparecer al bajar. Un observador por página, sin librerías: cuando un
// bloque entra en pantalla se le agrega `visto` y el CSS hace el resto.
// Se deja de observar apenas aparece: la animación es de entrada, no de ida
// y vuelta, y volver a esconder algo que ya se leyó marea.
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var bloques = document.querySelectorAll('.sube');

  if (reduce.matches || !('IntersectionObserver' in window)) {
    for (var i = 0; i < bloques.length; i++) { bloques[i].classList.add('visto'); }
  } else {
    var obs = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) {
        if (!e.isIntersecting) { return; }
        e.target.classList.add('visto');
        obs.unobserve(e.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    for (var j = 0; j < bloques.length; j++) { obs.observe(bloques[j]); }
  }

  // Lo que ya está en pantalla al cargar aparece enseguida, sin esperar a
  // que la persona baje: si no, la portada arranca vacía.
  requestAnimationFrame(function () {
    var alto = window.innerHeight;
    for (var k = 0; k < bloques.length; k++) {
      if (bloques[k].getBoundingClientRect().top < alto * 0.9) {
        bloques[k].classList.add('visto');
      }
    }
  });

  // Sombra en el encabezado apenas se despega del tope.
  var cab = document.getElementById('cabecera');
  var marcar = function () { cab.classList.toggle('pegado', window.scrollY > 8); };
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });
})();
</script>
{% block guion %}{% endblock %}
</body>
</html>
