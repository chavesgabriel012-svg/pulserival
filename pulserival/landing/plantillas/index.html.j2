{% extends "_publico.html.j2" %}
{% block titulo %}{{ marca }} — Los anuncios de su competencia en Meta y Google{% endblock %}

{% block estilos %}
  /* -- portada ------------------------------------------------- */
  /* Dos columnas: lo que es, a la izquierda, y por que sirve, a la derecha.
     El hero ocupa la primera pantalla menos lo justo para que asome el
     rotulo de la seccion de abajo ("El primer paso") y nada mas: se nota que
     hay mas pagina sin que el titular de abajo le compita al de arriba.
     --asoma es ese pedazo: el relleno de arriba de la seccion mas el rotulo.
     Sale de la altura de la ventana, asi que vale igual en una laptop de
     768px que en un monitor de 1080. */
  .hero { --cabecera:66px; --asoma:96px; padding:56px 0; display:grid; grid-template-columns:1.2fr 1fr;
          gap:56px; align-items:center;
          min-height:calc(100vh - var(--cabecera) - var(--asoma));
          min-height:calc(100svh - var(--cabecera) - var(--asoma)); }
  .hero h1 { font-size:50px; line-height:1.05; margin:0 0 22px; }
  .hero .bajada { font-size:19px; color:var(--gris-texto); max-width:52ch;
                  margin:0 0 34px; line-height:1.5; }
  .acciones { display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  /* En laptops de poca altura (768, 720) el hero grande no entra en la
     primera pantalla y el rotulo de abajo quedaba cortado. Se compacta solo
     ahi; en pantallas altas se queda grande. */
  @media (min-width:981px) and (max-height:820px) {
    .hero { padding:28px 0; gap:48px; }
    .hero h1 { font-size:42px; margin-bottom:16px; }
    .hero .bajada { font-size:17.5px; margin-bottom:26px; }
    .diapo { min-height:0; padding:24px 26px 22px; }
  }

  /* -- la caja de por que -------------------------------------- */
  /* Un carrusel sin libreria. La base es una fila con scroll-snap: sin
     JavaScript se pasa de una a otra deslizando, y nada queda escondido.
     Con JavaScript se suman las flechas, los puntos y el avance solo. */
  .porque-caja {
    background:var(--blanco); border:1px solid var(--linea); border-radius:var(--radio);
    box-shadow:0 14px 40px rgba(20,19,18,.07); overflow:hidden; position:relative;
  }
  .porque-cabeza {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:16px 24px; border-bottom:1px solid var(--linea);
  }
  /* El titulo de la caja va con la letra de los titulares, no con la del
     rotulo: es una pregunta que se lee, no una etiqueta. */
  .porque-cabeza .titulo-caja { font-family:var(--display); font-weight:700;
                                font-size:18px; letter-spacing:-.01em; margin:0; }
  .porque-cabeza .cuenta { font-family:var(--display); font-size:12px; letter-spacing:.08em;
                           color:var(--gris-texto); white-space:nowrap; }
  /* El avance: una linea naranja que se llena mientras corre cada diapositiva.
     Es el mismo pulso del encabezado, contando el tiempo. */
  .porque-avance { position:absolute; left:0; top:0; height:2px; width:100%;
                   background:var(--pulso); transform:scaleX(0); transform-origin:left;
                   transition-property:transform; transition-timing-function:linear; }
  .diapos {
    display:flex; overflow-x:auto; scroll-snap-type:x mandatory;
    scroll-behavior:smooth; scrollbar-width:none; -webkit-overflow-scrolling:touch;
    overscroll-behavior-x:contain;
  }
  .diapos::-webkit-scrollbar { display:none; }
  .diapo { flex:0 0 100%; scroll-snap-align:start; padding:30px 28px 28px;
           min-height:200px; display:flex; flex-direction:column; }
  .diapo .n { font-family:var(--display); font-size:13px; font-weight:500;
              letter-spacing:.1em; color:var(--pulso-texto); margin:0 0 14px; }
  .diapo h3 { font-size:26px; margin:0 0 12px; max-width:20ch; }
  .diapo p { font-size:17px; color:var(--gris-texto); line-height:1.5; margin:0;
             max-width:40ch; }
  .porque-pie {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:12px 18px 14px 24px; border-top:1px solid var(--linea);
  }
  .puntos { display:flex; gap:6px; }
  .puntos button {
    width:26px; height:26px; border:0; background:none; padding:0; cursor:pointer;
    display:grid; place-items:center; border-radius:50%;
  }
  .puntos button span { display:block; width:8px; height:8px; border-radius:50%;
                        background:var(--linea);
                        transition:background .25s var(--curva), width .25s var(--curva); }
  .puntos button[aria-current="true"] span { background:var(--pulso); width:20px;
                                             border-radius:4px; }
  .flechas { display:flex; gap:8px; }
  .flechas button {
    width:38px; height:38px; border:1px solid var(--linea); background:var(--blanco);
    border-radius:50%; cursor:pointer; color:var(--tinta); font-size:17px;
    display:grid; place-items:center; transition:border-color .2s var(--curva),
    background .2s var(--curva), color .2s var(--curva);
  }
  .flechas button:hover { border-color:var(--tinta); background:var(--tinta);
                          color:var(--papel); }
  .puntos button:focus-visible, .flechas button:focus-visible {
    outline:2px solid var(--pulso); outline-offset:2px; }
  /* Sin JavaScript no hay controles que funcionen: mejor no mostrarlos. */
  html:not(.js) .porque-pie, html:not(.js) .porque-cabeza .cuenta { display:none; }
  @media (pointer: coarse) {
    .puntos button { width:44px; height:44px; }
    .flechas button { width:44px; height:44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .diapos { scroll-behavior:auto; }
    .porque-avance { display:none; }
  }

  /* -- las dos bibliotecas ------------------------------------- */
  .fuentes { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .fuente {
    background:var(--blanco); border:1px solid var(--linea); padding:34px 32px;
    border-radius:var(--radio);
    transition:border-color .3s var(--curva), transform .3s var(--curva),
               box-shadow .3s var(--curva);
  }
  .fuente:hover { border-color:var(--piedra); transform:translateY(-3px);
                  box-shadow:0 10px 28px rgba(20,19,18,.07); }
  .fuente .nombre { font-family:var(--display); font-size:27px; font-weight:700;
                    letter-spacing:-.02em; margin:0; }
  .fuente .donde { font-size:16px; color:var(--gris-texto); margin:4px 0 6px; }
  .fuente .biblioteca {
    font-family:var(--display); font-size:11px; text-transform:uppercase;
    letter-spacing:.1em; color:var(--piedra); margin:0 0 24px; padding-bottom:20px;
    border-bottom:1px solid var(--linea); font-weight:500;
  }
  .fuente ul { list-style:none; padding:0; margin:0; }
  /* La lista usa grid en vez de posición absoluta: el guion queda alineado
     con la primera línea aunque el texto ocupe dos o tres, que es lo que
     estaba saliendo descentrado. */
  .fuente li {
    display:grid; grid-template-columns:18px 1fr; gap:10px; align-items:start;
    font-size:16px; padding:10px 0; color:var(--tinta);
  }
  .fuente li:before {
    content:""; width:14px; height:2px; background:var(--pulso);
    margin-top:.66em;
  }
  .fuente .pie-nota {
    margin:22px 0 0; padding-top:18px; border-top:1px solid var(--linea);
    font-size:15px; color:var(--gris-texto); line-height:1.55;
  }

  /* -- el proceso ---------------------------------------------- */
  .pasos { display:grid; grid-template-columns:repeat(4,1fr); gap:30px; }
  .paso .n {
    font-family:var(--display); font-size:13px; font-weight:500; letter-spacing:.1em;
    color:var(--pulso-texto); padding-bottom:14px; margin-bottom:18px; position:relative;
  }
  .paso .n:after {
    content:""; position:absolute; left:0; bottom:0; height:2px; width:100%;
    background:var(--pulso); transform:scaleX(0); transform-origin:left;
    transition:transform .7s var(--curva);
  }
  .js .sube.visto .paso .n:after, .paso.visto .n:after { transform:scaleX(1); }
  .paso h3 { font-size:19px; margin:0 0 9px; }
  .paso p { margin:0; font-size:16px; color:var(--gris-texto); line-height:1.5; }

  /* -- ventajas ------------------------------------------------ */
  .ventajas { display:grid; grid-template-columns:1fr 1fr; gap:44px 52px; }
  .ventaja h3 { font-size:20px; margin:0 0 9px; }
  .ventaja p { margin:0; font-size:16px; color:var(--gris-texto); line-height:1.5; }

  /* -- la muestra del correo ----------------------------------- */
  /* Esta es la parte que mas cuesta explicar con palabras: que el detalle
     va agrupado por competidor y por plataforma. Es una maqueta hecha con
     los mismos tokens, no una captura, asi que no se despixela ni se queda
     vieja cuando cambia la marca. */
  .muestra { display:grid; grid-template-columns:1fr 1.15fr; gap:48px;
             align-items:start; }
  .muestra.con-pasos { margin-top:72px; padding-top:56px;
                       border-top:1px solid var(--linea); }
  /* El texto se queda quieto mientras se recorre la muestra: es mas alta que
     el parrafo que la explica, y si no, se lee la mitad del ejemplo con media
     pantalla vacia al lado. */
  .muestra-texto { position:sticky; top:106px; }
  .muestra-texto h3 { font-size:27px; margin:0 0 14px; max-width:18ch; }
  .muestra-texto p { font-size:17px; color:var(--gris-texto); margin:0 0 16px;
                     line-height:1.55; max-width:44ch; }
  .muestra-texto .pie-muestra {
    font-family:var(--display); font-size:11.5px; letter-spacing:.04em;
    color:var(--piedra); line-height:1.6; text-transform:none; margin:0;
  }

  .correo { border:1px solid var(--linea); border-radius:var(--radio);
            overflow:hidden; background:var(--blanco);
            box-shadow:0 14px 40px rgba(20,19,18,.08); }
  .correo-barra { background:var(--tinta); padding:14px 20px; display:flex;
                  align-items:center; gap:14px; }
  .correo-barra img { height:17px; width:auto; display:block; }
  .correo-barra span { margin-left:auto; font-family:var(--display); font-size:10.5px;
                       color:var(--texto-osc-2); letter-spacing:.04em; }
  .correo-cuerpo { padding:22px 20px 24px; }
  .correo-asunto { font-family:var(--display); font-weight:700; font-size:19px;
                   letter-spacing:-.02em; margin:0 0 16px; }
  .correo-conteo { display:grid; grid-template-columns:repeat(4,1fr);
                   border-top:1.5px solid var(--tinta);
                   border-bottom:1px solid var(--linea); margin-bottom:22px; }
  .correo-conteo > div { text-align:center; padding:12px 4px;
                         border-right:1px solid var(--linea); }
  .correo-conteo > div:last-child { border-right:0; }
  .correo-conteo strong { display:block; font-family:var(--display); font-size:22px;
                          font-weight:700; letter-spacing:-.02em; }
  .correo-conteo span { font-family:var(--display); font-size:9.5px; letter-spacing:.09em;
                        text-transform:uppercase; color:var(--gris-texto); }
  .correo-conteo .alto strong { color:var(--pulso-texto); }
  .correo-rotulo { font-family:var(--display); font-weight:700; font-size:15px;
                   margin:0 0 4px; padding-bottom:8px;
                   border-bottom:1.5px solid var(--tinta); }
  .correo-competidor { margin-top:18px; }
  .correo-competidor .quien {
    font-family:var(--display); font-weight:700; font-size:15px; margin:0 0 2px;
    padding-bottom:7px; border-bottom:1px solid var(--linea);
  }
  .correo-competidor .quien span { font-family:var(--cuerpo); font-weight:400;
                                   font-size:13.5px; color:var(--gris-texto); }
  .correo-plataforma {
    font-family:var(--display); font-size:9.5px; letter-spacing:.09em;
    text-transform:uppercase; color:var(--piedra); margin:14px 0 8px; font-weight:500;
  }
  .correo-anuncio { margin-bottom:12px; }
  .correo-anuncio .marca-estado { margin:0 0 2px; font-size:13px; }
  .correo-anuncio .ref { font-family:var(--display); font-size:11.5px;
                         font-weight:500; color:var(--tinta); }
  /* El estado se distingue por simbolo ademas de por color: el naranja solo
     no le sirve a quien no lo ve. Es la misma regla que en el correo real. */
  .correo-anuncio .estado { color:var(--gris-texto); font-size:13px; }
  .correo-anuncio .estado.nuevo { color:var(--pulso-texto); font-weight:600; }
  .correo-anuncio .detalle { color:var(--piedra); font-size:12.5px; }
  .correo-anuncio .texto { margin:0 0 3px; font-size:13.5px; color:var(--gris-texto);
                           line-height:1.45; }
  .correo-anuncio .fuente-enlace {
    margin:0; font-size:12.5px; color:var(--tinta);
    text-decoration:underline; text-underline-offset:2px;
  }

  /* -- los planes --------------------------------------------- */
  /* Dos tarjetas lado a lado: el de $25, que se compra desde la web, y el
     Custom, que se conversa. Si se paga cada mes o el año entero no se elige
     aca: se elige en el checkout. */
  .planes { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:stretch; }
  .plan {
    background:var(--blanco); border:1px solid var(--linea); border-radius:var(--radio);
    padding:34px 32px 30px; display:flex; flex-direction:column;
    transition:border-color .3s var(--curva), transform .3s var(--curva),
               box-shadow .3s var(--curva);
  }
  .plan:hover { border-color:var(--piedra); transform:translateY(-3px);
                box-shadow:0 10px 28px rgba(20,19,18,.07); }
  .plan.principal { border:1.5px solid var(--tinta); }
  .plan.principal:hover { border-color:var(--tinta); }
  .plan .nombre { font-family:var(--display); font-size:12px; text-transform:uppercase;
                  letter-spacing:.1em; color:var(--pulso-texto); margin:0 0 12px;
                  font-weight:500; }
  .plan .precio { font-family:var(--display); font-size:46px; font-weight:700;
                  line-height:1; letter-spacing:-.03em; margin:0 0 10px; }
  .plan .precio span { font-family:var(--cuerpo); font-size:16px; font-weight:400;
                       color:var(--gris-texto); letter-spacing:0; }
  .plan .precio.cotizado { font-size:34px; padding:6px 0 4px; }
  .plan .pista-anual { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px;
                       font-size:14px; color:var(--gris-texto); margin:2px 0 14px;
                       line-height:1.4; }
  .plan .pista-anual .ahorra {
    font-family:var(--display); font-size:12px; letter-spacing:.08em; text-transform:uppercase;
    background:var(--pulso); color:var(--blanco); padding:3px 8px; border-radius:3px;
    font-weight:500; white-space:nowrap;
  }
  .plan .titular { font-size:16px; color:var(--gris-texto); line-height:1.5;
                   margin:0 0 22px; min-height:3em; }
  .plan .datos { border-top:1px solid var(--linea); margin-bottom:16px; }
  .plan .dato {
    display:flex; justify-content:space-between; gap:12px; font-size:14px;
    padding:11px 0; border-bottom:1px solid var(--linea);
  }
  .plan .dato .clave { color:var(--gris-texto); }
  .plan .dato .valor { font-family:var(--display); font-weight:600; text-align:right; }
  .plan ul { list-style:none; padding:0; margin:0 0 26px; flex:1; }
  .plan li {
    display:grid; grid-template-columns:16px 1fr; gap:9px; align-items:start;
    font-size:15.5px; padding:7px 0; color:var(--tinta);
  }
  .plan li:before { content:""; width:12px; height:2px; background:var(--pulso);
                    margin-top:.66em; }
  .plan .btn { width:100%; text-align:center; }
  .plan .sin-contacto { font-size:14px; color:var(--gris-texto); margin:0; }

  /* -- contacto ------------------------------------------------ */
  /* El correo va grande y es el boton: es lo unico que hay que hacer aca. */
  .contacto { display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; }
  .contacto .entrada { margin:0; }
  .contacto-caja {
    background:var(--blanco); border:1px solid var(--linea); border-radius:var(--radio);
    padding:30px 30px 28px;
  }
  .contacto-caja .etiqueta { font-family:var(--display); font-size:12px; letter-spacing:.1em;
                             text-transform:uppercase; color:var(--gris-texto); margin:0 0 8px; }
  .contacto-caja .correo-grande {
    display:block; font-family:var(--display); font-weight:700; font-size:26px;
    letter-spacing:-.02em; color:var(--tinta); text-decoration:none; margin:0 0 22px;
    overflow-wrap:anywhere;
  }
  .contacto-caja .correo-grande:hover { color:var(--pulso-texto); }
  .contacto-caja .btn { margin-right:10px; }

  /* -- llamada final ------------------------------------------- */
  /* El relleno de arriba es parte de --asoma del hero: si cambia uno, cambia
     el otro. El rotulo no se anima: es lo que asoma en la primera pantalla y
     tiene que estar quieto ahi. Lo de abajo aparece al bajar. */
  .cierre { text-align:center; padding:56px 0 96px; background:var(--tinta); }
  .cierre .rotulo { color:var(--pulso-oscuro); margin-bottom:30px; }
  .cierre h2 { margin:0 auto 20px; max-width:20ch; font-size:42px; color:var(--papel); }
  .cierre p { font-size:18px; color:var(--texto-osc-2); max-width:54ch;
              margin:0 auto 36px; line-height:1.5; }

  @media (max-width:980px) {
    .pasos { grid-template-columns:1fr 1fr; gap:34px; }
    .muestra { grid-template-columns:1fr; gap:32px; }
    .muestra-texto { position:static; }
    .muestra-texto h3, .muestra-texto p { max-width:none; }
    /* La caja baja debajo del texto: al lado, en una tableta, las dos
       columnas quedaban angostas y el titular partido en cinco lineas. */
    .hero { grid-template-columns:1fr; gap:36px; padding:48px 0 52px; }
    .hero h1 { font-size:40px; max-width:22ch; }
    .cierre h2 { font-size:32px; } .cierre { padding:56px 0 72px; }
    .contacto { grid-template-columns:1fr; gap:28px; }
  }
  @media (max-width:640px) {
    .fuentes, .ventajas, .pasos { grid-template-columns:1fr; }
    .correo-conteo { grid-template-columns:1fr 1fr; }
    .correo-conteo > div:nth-child(2) { border-right:0; }
    /* Los rotulos del ejemplo bajan a 9,5px en pantalla grande porque ahi la
       maqueta es chica al lado del texto. En el celular ocupa todo el ancho
       y no hay razon para achicarlos. */
    .correo-conteo span, .correo-plataforma, .correo-barra span { font-size:12px; }
    .fuente .biblioteca, .muestra-texto .pie-muestra, .correo-anuncio .ref { font-size:12px; }
    .hero { padding:36px 0 44px; gap:28px; }
    .hero h1 { font-size:32px; }
    .hero .bajada { font-size:17px; margin-bottom:24px; }
    .diapo { padding:22px 20px 20px; min-height:0; }
    .diapo h3 { font-size:21px; }
    .porque-cabeza { padding:14px 20px; }
    .porque-cabeza .titulo-caja { font-size:16.5px; }
    .porque-pie { padding:10px 12px 10px 16px; }
    /* Los dos botones al ancho completo: apilados y de distinto largo se ven
       desprolijos, y de paso el blanco de toque queda comodo. */
    .acciones { display:grid; grid-template-columns:1fr; gap:12px; }
    .acciones .btn { text-align:center; }
    .planes { grid-template-columns:1fr; }
    .plan { padding:26px 22px 24px; }
    .plan .titular { min-height:0; }
    .cierre { padding:56px 0 64px; }
    .cierre h2 { font-size:28px; }
    .contacto-caja { padding:24px 20px 22px; }
    .contacto-caja .correo-grande { font-size:21px; }
    .contacto-caja .btn { display:block; text-align:center; margin:0 0 10px; }
  }
{% endblock %}

{% block guion %}
<script>
// La caja de por que. Avanza sola cada tantos segundos y no se detiene nunca
// del todo: se pausa mientras el puntero está encima (o el foco del teclado
// adentro) y sigue desde donde iba cuando sale. Usar las flechas, los puntos
// o deslizar con el dedo cambia de diapositiva y vuelve a contar desde cero.
// Con menos movimiento pedido no avanza sola. Sin JavaScript queda la fila
// deslizable.
(function () {
  var caja = document.getElementById('porque-caja');
  if (!caja) { return; }
  var fila = caja.querySelector('.diapos');
  var diapos = [].slice.call(fila.querySelectorAll('.diapo'));
  var puntos = [].slice.call(caja.querySelectorAll('.puntos button'));
  var actualTxt = caja.querySelector('[data-actual]');
  var avance = caja.querySelector('.porque-avance');
  if (diapos.length < 2) { return; }
  var ESPERA = 6000;
  var quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var actual = 0;
  var reloj = null;
  var restante = ESPERA;   // lo que le falta a la diapositiva de ahora
  var desde = 0;           // cuándo arrancó el tramo que está corriendo
  var encima = false;
  var conFoco = false;

  function marcar(i) {
    actual = i;
    puntos.forEach(function (b, k) {
      if (k === i) { b.setAttribute('aria-current', 'true'); }
      else { b.removeAttribute('aria-current'); }
    });
    if (actualTxt) { actualTxt.textContent = (i < 9 ? '0' : '') + (i + 1); }
  }

  function barra(escala, ms) {
    if (!avance) { return; }
    avance.style.transitionDuration = ms + 'ms';
    avance.style.transform = 'scaleX(' + escala + ')';
  }

  function puedeCorrer() { return !quieto && !encima && !conFoco && !document.hidden; }

  function correr() {
    clearTimeout(reloj);
    reloj = null;
    if (!puedeCorrer()) { return; }
    desde = Date.now();
    barra(1, restante);
    reloj = setTimeout(function () { ir(actual + 1); }, restante);
  }

  // Pausar congela la barra donde iba y guarda lo que falta.
  function pausar() {
    if (!reloj) { return; }
    clearTimeout(reloj);
    reloj = null;
    restante = Math.max(0, restante - (Date.now() - desde));
    var m = avance ? getComputedStyle(avance).transform : 'none';
    var escala = m.indexOf('matrix') === 0 ? parseFloat(m.slice(7).split(',')[0]) : 0;
    barra(escala, 0);
  }

  function ir(i) {
    i = (i + diapos.length) % diapos.length;
    fila.scrollTo({ left: diapos[i].offsetLeft - fila.offsetLeft,
                    behavior: quieto ? 'auto' : 'smooth' });
    marcar(i);
    clearTimeout(reloj);
    reloj = null;
    restante = ESPERA;
    barra(0, 0);
    if (avance) { void avance.offsetWidth; }
    correr();
  }

  puntos.forEach(function (b, k) {
    b.addEventListener('click', function () { ir(k); });
  });
  caja.querySelectorAll('[data-ir]').forEach(function (b) {
    b.addEventListener('click', function () {
      ir(actual + parseInt(b.getAttribute('data-ir'), 10));
    });
  });
  // Deslizar con el dedo: se sigue la diapositiva que quedó a la vista.
  var espera = null;
  fila.addEventListener('scroll', function () {
    clearTimeout(espera);
    espera = setTimeout(function () {
      var i = Math.max(0, Math.min(Math.round(fila.scrollLeft / fila.clientWidth),
                                   diapos.length - 1));
      if (i !== actual) { ir(i); }
    }, 120);
  }, { passive: true });
  caja.addEventListener('pointerenter', function (e) {
    if (e.pointerType === 'mouse') { encima = true; pausar(); }
  });
  caja.addEventListener('pointerleave', function (e) {
    if (e.pointerType === 'mouse') { encima = false; correr(); }
  });
  // El foco pausa solo si viene del teclado: un clic con el mouse también
  // deja el foco en el botón, y la caja quedaría pausada después de que el
  // puntero se fue.
  caja.addEventListener('focusin', function (e) {
    if (e.target.matches && e.target.matches(':focus-visible')) { conFoco = true; pausar(); }
  });
  caja.addEventListener('focusout', function (e) {
    if (!caja.contains(e.relatedTarget)) { conFoco = false; correr(); }
  });
  fila.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight') { e.preventDefault(); ir(actual + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); ir(actual - 1); }
  });
  // Fuera de la pantalla no tiene sentido que avance.
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { pausar(); } else { correr(); }
  });

  marcar(0);
  correr();
})();
</script>
{% endblock %}

{% block navegacion %}
  <a class="oculto" href="#fuentes">¿Qué revisamos?</a>
  <a class="oculto" href="#como">¿Cómo funciona?</a>
  <a href="#planes">Planes</a>
  {% if correo_soporte %}<a class="oculto" href="#contacto">Contacto</a>{% endif %}
  <a class="cta" href="{{ aplicar_url }}">Empezar</a>
{% endblock %}

{% block contenido %}
<div class="env">
  <div class="hero">
    <div class="hero-texto">
      <h1 class="sube">{{ titulo }}</h1>
      <p class="bajada sube" style="transition-delay:.08s">{{ subtitulo }}</p>
      <div class="acciones sube" style="transition-delay:.16s">
        <a class="btn" href="#planes"><span>Ver los planes</span></a>
        <a class="btn alt" href="#como"><span>Ver cómo funciona</span></a>
      </div>
    </div>

    {% if por_que and por_que.diapositivas %}
    {% set diapos = por_que.diapositivas[:4] %}
    <div class="porque-caja sube" style="transition-delay:.24s" id="porque-caja"
         role="region" aria-roledescription="carrusel" aria-label="{{ por_que.rotulo }}">
      <span class="porque-avance" aria-hidden="true"></span>
      <div class="porque-cabeza">
        <p class="titulo-caja">{{ por_que.rotulo }}</p>
        <span class="cuenta" aria-hidden="true"><span data-actual>01</span> / {{ "%02d"|format(diapos|length) }}</span>
      </div>
      <div class="diapos" tabindex="0" aria-live="off">
        {% for d in diapos %}
        <div class="diapo" role="group" aria-roledescription="diapositiva"
             aria-label="{{ loop.index }} de {{ diapos|length }}">
          <p class="n">{{ "%02d"|format(loop.index) }}</p>
          <h3>{{ d.titulo }}</h3>
          <p>{{ d.texto }}</p>
        </div>
        {% endfor %}
      </div>
      {% if diapos|length > 1 %}
      <div class="porque-pie">
        <div class="puntos">
          {% for d in diapos %}
          <button type="button" aria-label="Ir a la {{ loop.index }}"
                  {% if loop.first %}aria-current="true"{% endif %}><span></span></button>
          {% endfor %}
        </div>
        <div class="flechas">
          <button type="button" data-ir="-1" aria-label="Anterior">&larr;</button>
          <button type="button" data-ir="1" aria-label="Siguiente">&rarr;</button>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>

<section class="cierre">
  <div class="env">
    <p class="rotulo">El primer paso</p>
    <h2 class="sube">Su competencia ya está anunciando. La pregunta es si usted lo sabe.</h2>
    {# Antes decía que el primer reporte no tenía costo. La prueba gratis no
       está en este lanzamiento: dejarlo habría sido prometer algo que el
       checkout después cobra. #}
    <p class="sube" style="transition-delay:.1s">{{ plan_seccion.cierre }}</p>
    {# El botón va envuelto: la animación de aparición le fija el transform y
       le quitaría el levantarse al pasar el mouse. #}
    <div class="sube" style="transition-delay:.2s">
      <a class="btn" href="#planes"><span>Ver los planes</span></a>
    </div>
  </div>
</section>

{% if plataformas %}
<section id="fuentes">
  <div class="env">
    <div class="sube">
      <p class="rotulo">Las fuentes</p>
      <h2>{{ plataformas.titulo }}</h2>
      {% if plataformas.nota %}<p class="entrada">{{ plataformas.nota }}</p>{% endif %}
    </div>
    <div class="fuentes">
      {% for f in plataformas.fuentes %}
      <div class="fuente sube" style="transition-delay:{{ loop.index0 * 0.12 }}s">
        <p class="nombre">{{ f.nombre }}</p>
        <p class="donde">{{ f.donde }}</p>
        <p class="biblioteca">{{ f.biblioteca }}</p>
        <ul>{% for i in f.lee %}<li><span>{{ i }}</span></li>{% endfor %}</ul>
        {% if f.nota %}<p class="pie-nota">{{ f.nota }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# La seccion sale si hay pasos o si hay ejemplo: el ejemplo no depende de
   que existan los pasos, y colgarlo de ellos lo hacia desaparecer sin aviso
   cuando faltaban. #}
{% if pasos or ejemplo %}
<section id="como">
  <div class="env">
    {% if pasos %}
    <div class="sube">
      <p class="rotulo">El proceso</p>
      <h2>{{ pasos.titulo }}</h2>
    </div>
    <div class="pasos">
      {% for p in pasos.lista %}
      <div class="paso sube" style="transition-delay:{{ loop.index0 * 0.13 }}s">
        <div class="n">{{ "%02d"|format(loop.index) }}</div>
        <h3>{{ p.nombre }}</h3>
        <p>{{ p.texto }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if ejemplo %}
    <div class="muestra{% if pasos %} con-pasos{% endif %} sube">
      <div class="muestra-texto">
        <h3>{{ ejemplo.titulo }}</h3>
        <p>{{ ejemplo.nota }}</p>
        <p class="pie-muestra">{{ ejemplo.pie }}</p>
      </div>

      {# Maqueta del correo, no una captura: se mantiene sola con los mismos
         tokens de marca y no se despixela en pantallas grandes. #}
      <div class="correo" aria-label="Ejemplo de reporte">
        <div class="correo-barra">
          <img src="{{ marca_url }}/logo-negativo.svg" alt="{{ marca }}">
          <span>{{ ejemplo.periodo }}</span>
        </div>
        <div class="correo-cuerpo">
          <p class="correo-asunto">{{ ejemplo.asunto }}</p>
          <div class="correo-conteo">
            {% for c in ejemplo.conteo %}
            <div{% if c.destacado %} class="alto"{% endif %}>
              <strong>{{ c.valor }}</strong><span>{{ c.etiqueta }}</span>
            </div>
            {% endfor %}
          </div>
          <p class="correo-rotulo">Detalle de anuncios</p>
          {% for comp in ejemplo.competidores %}
          <div class="correo-competidor">
            <p class="quien">{{ comp.nombre }} <span>{{ comp.resumen }}</span></p>
            {% for b in comp.bloques %}
            <p class="correo-plataforma">{{ b.plataforma }}</p>
            {% for a in b.anuncios %}
            <div class="correo-anuncio">
              <p class="marca-estado">
                <span class="ref">[{{ a.referencia }}]</span>
                <span class="estado {{ 'nuevo' if a.estado == 'nuevo' }}">
                  {%- if a.estado == 'nuevo' %}+
                  {%- elif a.estado == 'cambiado' %}&#916;
                  {%- else %}&#8722;{% endif %} {{ a.estado }}</span>
                <span class="detalle">{{ a.detalle }}</span>
              </p>
              <p class="texto">{{ a.texto }}</p>
              <p class="fuente-enlace">Ver en la fuente</p>
            </div>
            {% endfor %}
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section id="porque">
  <div class="env">
    <div class="sube">
      <p class="rotulo">Por qué sirve</p>
      <h2>Los datos son públicos. El trabajo de mirarlos, no.</h2>
    </div>
    <div class="ventajas">
      {% for a in argumentos %}
      <div class="ventaja sube" style="transition-delay:{{ loop.index0 * 0.1 }}s">
        <h3>{{ a.titulo }}</h3>
        <p>{{ a.texto }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="planes">
  <div class="env">
    <div class="sube">
      <p class="rotulo">{{ plan_seccion.rotulo }}</p>
      <h2>{{ plan_seccion.titulo }}</h2>
      <p class="entrada">{{ plan_seccion.entrada }}</p>
    </div>
    {% set enlace_contacto = ('https://wa.me/' ~ contacto.whatsapp) if contacto.whatsapp
                             else (('mailto:' ~ contacto.email) if contacto.email else '') %}
    <div class="planes">
      {% for p in planes_visibles %}
      <div class="plan sube{% if p.checkout %} principal{% endif %}"
           style="transition-delay:{{ loop.index0 * 0.1 }}s">
        <p class="nombre">{{ p.nombre }}</p>
        {% if p.checkout and p.precio_usd %}
        <p class="precio">${{ '%g' % p.precio_usd }}<span> / mes</span></p>
        {# Una pista del pago anual, chica: el anual se elige en el checkout,
           pero quien compara precios tiene que saber que existe. #}
        {% set anual = (p.ciclos or {}).values() | selectattr("ahorro_usd") | first %}
        {% if anual %}
        <p class="pista-anual"><span class="ahorra">Ahorra ${{ '%g' % anual.ahorro_usd }}</span>
          <span>Pagando el año{% if anual.equivale_mes_usd %}: ${{ '%g' % anual.equivale_mes_usd }} al mes{% endif %}</span></p>
        {% endif %}
        {% else %}
        <p class="precio cotizado">{{ plan_seccion.cotizado or 'A cotizar' }}</p>
        {% endif %}
        <p class="titular">{{ p.para_quien or p.resumen }}</p>
        <div class="datos">
          <div class="dato">
            <span class="clave">Frecuencia</span>
            <span class="valor">{{ p.cadencia_texto or '—' }}</span>
          </div>
          <div class="dato">
            <span class="clave">Competidores</span>
            <span class="valor">
              {%- if p.competidores_max %}Hasta {{ p.competidores_max }}
              {%- else %}Los que necesite{% endif -%}
            </span>
          </div>
        </div>
        <ul>{% for i in p.incluye %}<li><span>{{ i }}</span></li>{% endfor %}</ul>
        {% if p.checkout %}
        <a class="btn" href="{{ aplicar_url }}?plan={{ p.clave }}"><span>Empezar</span></a>
        {% elif enlace_contacto %}
        {# El Custom no tiene checkout: se cotiza conversando y se cobra con un
           link de pago armado a mano en Paddle. #}
        <a class="btn alt" href="{{ enlace_contacto }}"><span>{{ plan_seccion.boton_contacto or 'Conversemos' }}</span></a>
        {% else %}
        <p class="sin-contacto">Escríbanos para cotizarlo.</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if correo_soporte %}
<section id="contacto">
  <div class="env contacto">
    <div class="sube">
      <p class="rotulo">{{ contacto_seccion.rotulo or 'Contacto' }}</p>
      <h2>{{ contacto_seccion.titulo }}</h2>
      <p class="entrada">{{ contacto_seccion.texto }}</p>
    </div>
    <div class="contacto-caja sube" style="transition-delay:.1s">
      <p class="etiqueta">Correo de soporte</p>
      <a class="correo-grande" href="mailto:{{ correo_soporte }}">{{ correo_soporte }}</a>
      <a class="btn" href="mailto:{{ correo_soporte }}"><span>Escribirnos</span></a>
      {% if contacto.whatsapp %}
      <a class="btn alt" href="https://wa.me/{{ contacto.whatsapp }}"><span>WhatsApp</span></a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
