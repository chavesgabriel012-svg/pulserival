<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ marca }} — Inteligencia publicitaria de su competencia</title>
<meta name="description" content="{{ subtitulo }}">
<style>
  :root { --negro:#000; --gris:#6b6b6b; --linea:#d4d4d4; --suave:#f4f4f4; }
  * { box-sizing: border-box; }
  body {
    margin:0; background:#fff; color:#1b1b1b;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    line-height:1.6; -webkit-font-smoothing:antialiased;
  }
  .env { max-width:980px; margin:0 auto; padding:0 24px; }
  a { color:var(--negro); }
  header { background:var(--negro); padding:18px 0; }
  header img { display:block; height:24px; width:auto; }
  .hero { padding:72px 0 56px; border-bottom:1px solid var(--linea); }
  .hero h1 { font-size:40px; line-height:1.18; margin:0 0 20px; letter-spacing:-.4px; }
  .hero p { font-size:18px; color:#3a3a3a; max-width:62ch; margin:0 0 28px; }
  .btn {
    display:inline-block; background:var(--negro); color:#fff; text-decoration:none;
    padding:14px 26px; font-weight:600; font-size:15px; border:2px solid var(--negro);
  }
  .btn:hover { background:#fff; color:var(--negro); }
  .btn.alt { background:#fff; color:var(--negro); }
  .btn.alt:hover { background:var(--negro); color:#fff; }
  section { padding:56px 0; border-bottom:1px solid var(--linea); }
  h2 { font-size:13px; text-transform:uppercase; letter-spacing:1.4px; margin:0 0 28px;
       padding-bottom:8px; border-bottom:2px solid var(--negro); display:inline-block; }
  .cols { display:grid; grid-template-columns:repeat(3,1fr); gap:32px; }
  .cols h3 { font-size:17px; margin:0 0 8px; }
  .cols p { margin:0; color:#3a3a3a; font-size:15px; }
  .planes { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; align-items:start; }
  .plan { border:1px solid var(--linea); padding:24px 20px; display:flex;
          flex-direction:column; min-height:100%; }
  .plan.destacado { border:2px solid var(--negro); }
  .plan .nombre { font-size:12px; text-transform:uppercase; letter-spacing:1.2px;
                  color:var(--gris); margin-bottom:10px; }
  .plan .precio { font-size:34px; font-weight:600; line-height:1; margin-bottom:4px; }
  .plan .precio span { font-size:14px; font-weight:400; color:var(--gris); }
  .plan .resumen { font-size:14px; color:#3a3a3a; margin:12px 0 16px; }
  .plan ul { list-style:none; padding:0; margin:0 0 22px; font-size:14px; }
  .plan li { padding:6px 0 6px 16px; position:relative; border-top:1px solid #ededed; }
  .plan li:before { content:"—"; position:absolute; left:0; color:var(--gris); }
  .plan .pie { margin-top:auto; }
  .plan .btn { width:100%; text-align:center; padding:11px 8px; font-size:14px; }
  form { display:grid; gap:18px; max-width:640px; }
  .campo label { display:block; font-size:13px; font-weight:600; margin-bottom:6px; }
  .campo .ayuda { font-size:13px; color:var(--gris); font-weight:400; margin-bottom:6px; }
  input, textarea, select {
    width:100%; padding:11px 12px; border:1px solid var(--linea); font-size:15px;
    font-family:inherit; background:#fff; color:#1b1b1b;
  }
  input:focus, textarea:focus, select:focus { outline:2px solid var(--negro); border-color:var(--negro); }
  textarea { min-height:96px; resize:vertical; }
  fieldset { border:1px solid var(--linea); padding:18px; margin:0; }
  legend { font-size:13px; font-weight:600; padding:0 8px; }
  .competidor { display:grid; gap:10px; margin-bottom:14px; padding-bottom:14px;
                border-bottom:1px solid #ededed; }
  .competidor:last-child { border-bottom:0; margin-bottom:0; padding-bottom:0; }
  .fila { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .nota { background:var(--suave); padding:16px 18px; font-size:14px; color:#3a3a3a;
          border-left:3px solid var(--negro); }
  footer { background:var(--negro); color:#b0b0b0; padding:28px 0; font-size:13px; }
  footer a { color:#fff; }
  @media (max-width:860px) {
    .planes { grid-template-columns:repeat(2,1fr); }
    .cols { grid-template-columns:1fr; gap:24px; }
    .hero h1 { font-size:30px; }
    .hero { padding:48px 0 40px; }
  }
  @media (max-width:520px) {
    .planes, .fila { grid-template-columns:1fr; }
  }
</style>
</head>
<body>

<header>
  <div class="env">
    {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="{{ marca }}">
    {% else %}<span style="color:#fff;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;">{{ marca }}</span>{% endif %}
  </div>
</header>

<div class="env">

  <div class="hero">
    <h1>{{ titulo }}</h1>
    <p>{{ subtitulo }}</p>
    <a class="btn" href="#planes">Ver los planes</a>
  </div>

  <section>
    <h2>Por qué sirve</h2>
    <div class="cols">
      {% for a in argumentos %}
      <div>
        <h3>{{ a.titulo }}</h3>
        <p>{{ a.texto }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <section id="planes">
    <h2>Planes</h2>
    <div class="planes">
      {% for p in planes %}
      <div class="plan{% if p.clave == 'semanal' %} destacado{% endif %}">
        <div class="nombre">{{ p.nombre }}</div>
        {% if p.precio_usd is none %}
          <div class="precio">A convenir</div>
        {% elif p.precio_usd == 0 %}
          <div class="precio">Gratis</div>
        {% else %}
          <div class="precio">${{ p.precio_usd }}<span> / mes</span></div>
        {% endif %}
        <div class="resumen">{{ p.resumen }}</div>
        <ul>
          {% for i in p.incluye %}<li>{{ i }}</li>{% endfor %}
        </ul>
        <div class="pie">
          {% if p.enlace_pago %}
          <a class="btn" href="{{ p.enlace_pago }}">
            {% if p.precio_usd == 0 %}Empezar{% else %}Contratar{% endif %}
          </a>
          {% else %}
          <a class="btn alt" href="#empezar">Hablemos</a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section id="empezar">
    <h2>{{ formulario.titulo }}</h2>
    <p style="max-width:62ch;color:#3a3a3a;margin-top:0;">{{ formulario.nota }}</p>

    <form id="alta" novalidate{% if modo_servidor %} method="post" action="{{ accion_alta }}"{% endif %}>
      <div class="campo">
        <label for="empresa">Nombre de su empresa</label>
        <input id="empresa" name="empresa" required>
      </div>

      <div class="fila">
        <div class="campo">
          <label for="contacto">Su nombre</label>
          <input id="contacto" name="contacto" required>
        </div>
        <div class="campo">
          <label for="email">Correo donde quiere recibir el reporte</label>
          <input id="email" name="email" type="email" required>
        </div>
      </div>

      <div class="fila">
        <div class="campo">
          <label for="plan">Plan</label>
          <select id="plan" name="plan">
            {% for p in planes %}
            <option value="{{ p.clave }}">{{ p.nombre }}{% if p.precio_usd %} — ${{ p.precio_usd }}/mes{% elif p.precio_usd == 0 %} — sin costo{% endif %}</option>
            {% endfor %}
          </select>
        </div>
        <div class="campo">
          <label for="industria">Industria</label>
          <input id="industria" name="industria" placeholder="En sus palabras">
        </div>
      </div>

      <div class="campo">
        <label for="contexto">Contexto de su negocio</label>
        <div class="ayuda">
          Tres o cuatro líneas: qué le preocupa, si compite por precio o por
          servicio, cuántas sedes tiene, su ticket promedio. Esto es lo que más
          sube la calidad del reporte.
        </div>
        <textarea id="contexto" name="contexto"></textarea>
      </div>

      <fieldset>
        <legend>Sus competidores</legend>
        <div class="ayuda" style="font-size:13px;color:var(--gris);margin-bottom:14px;">
          De cada uno necesitamos su página de Facebook (o cómo aparece en la
          biblioteca de anuncios) y su dominio. Con uno solo de los dos también
          se puede: se cubre esa plataforma y se avisa de la otra.
        </div>
        {% for n in [1, 2, 3] %}
        <div class="competidor">
          <div class="campo">
            <label for="comp{{ n }}">Competidor {{ n }}{% if n > 1 %} (opcional){% endif %}</label>
            <input id="comp{{ n }}" name="comp{{ n }}" placeholder="Nombre">
          </div>
          <div class="fila">
            <input name="fb{{ n }}" placeholder="facebook.com/sucompetidor">
            <input name="web{{ n }}" placeholder="sucompetidor.co.cr">
          </div>
        </div>
        {% endfor %}
      </fieldset>

      <div>
        <button class="btn" type="submit">Enviar</button>
      </div>

      <div class="nota">
        {% if modo_servidor %}
        Al enviar le mostramos un resumen para confirmar antes de activar nada.
        {% else %}
        Al enviar se abre WhatsApp con sus datos ya ordenados. Nada se guarda en
        esta página.
        {% endif %}
      </div>
    </form>
  </section>

</div>

<footer>
  <div class="env">
    {{ marca }}{% if dominio %} · {{ dominio }}{% endif %}<br>
    Fuentes: Biblioteca de Anuncios de Meta y Centro de Transparencia de Anuncios
    de Google, ambas públicas. Las plataformas no publican inversión, alcance ni
    clics de los anuncios comerciales, de modo que los reportes no los incluyen.
  </div>
</footer>

{% if not modo_servidor %}
<script>
// Sin servidor: el formulario arma un mensaje ordenado y lo manda por
// WhatsApp, que es donde se cierran las ventas. Si no hay número
// configurado, cae al correo.
(function () {
  var WHATSAPP = {{ contacto.whatsapp | default('', true) | tojson }};
  var EMAIL = {{ contacto.email | default('', true) | tojson }};

  document.getElementById('alta').addEventListener('submit', function (e) {
    e.preventDefault();
    var d = new FormData(e.target);
    var v = function (k) { return (d.get(k) || '').toString().trim(); };

    if (!v('empresa') || !v('email')) {
      alert('Hacen falta el nombre de la empresa y el correo.');
      return;
    }

    var l = [];
    l.push('Solicitud de reporte — ' + v('empresa'));
    l.push('');
    l.push('Plan: ' + v('plan'));
    l.push('Contacto: ' + v('contacto') + ' · ' + v('email'));
    if (v('industria')) { l.push('Industria: ' + v('industria')); }
    if (v('contexto')) { l.push(''); l.push('Contexto: ' + v('contexto')); }

    var comps = [];
    for (var i = 1; i <= 3; i++) {
      var nombre = v('comp' + i);
      if (!nombre) { continue; }
      var partes = [nombre];
      if (v('fb' + i)) { partes.push('Facebook: ' + v('fb' + i)); }
      if (v('web' + i)) { partes.push('Web: ' + v('web' + i)); }
      comps.push('  ' + partes.join(' | '));
    }
    if (comps.length) { l.push(''); l.push('Competidores:'); l = l.concat(comps); }

    var texto = l.join('\n');
    if (WHATSAPP) {
      window.open('https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(texto), '_blank');
    } else if (EMAIL) {
      window.location.href = 'mailto:' + EMAIL +
        '?subject=' + encodeURIComponent('Solicitud de reporte — ' + v('empresa')) +
        '&body=' + encodeURIComponent(texto);
    } else {
      alert('Falta configurar el contacto en config/landing.yaml');
    }
  });
})();
</script>
{% endif %}
</body>
</html>
