{% extends "_base.html.j2" %}
{% block titulo %}Confirmar — {{ marca }}{% endblock %}
{% block contenido %}

{% if simulado %}
<div class="aviso">
  <strong>Cobro simulado</strong><br>
  Esta pantalla todavía no cobra. Confirmar acá activa la cuenta sin mover
  plata: sirve para probar el flujo completo antes de conectar la pasarela.
</div>
{% endif %}

<h1>{{ cliente["nombre_empresa"] }}</h1>
<p>Revise que esté todo bien antes de confirmar.</p>

<h2>Su plan</h2>
<table>
  <tr><th>Plan</th><td>{{ plan.nombre or cliente["plan"] }}</td></tr>
  <tr><th>Precio</th><td>
    {% if ciclo and ciclo.cobro_texto %}{{ ciclo.cobro_texto }}
      {%- if ciclo.equivale_mes_usd %} (equivale a ${{ '%g' % ciclo.equivale_mes_usd }} al mes){% endif %}
    {% elif precio %}${{ '%g' % precio }} por mes{% elif precio == 0 %}Sin costo{% else %}A convenir{% endif %}
  </td></tr>
  <tr><th>Cadencia</th><td>
    {% if cliente["cadencia_dias"] %}Cada {{ cliente["cadencia_dias"] }} días
    {% else %}{{ plan.cadencia_texto or cliente["periodicidad"] }}{% endif %}
  </td></tr>
  <tr><th>Reporte a</th><td>{{ cliente["contacto_email"] }}</td></tr>
</table>

<h2>Competidores que vamos a seguir</h2>
{% if not competidores %}
<div class="nota">
  No nos indicó competidores: los investigamos nosotros a partir de su
  industria y le escribimos con la lista antes del primer reporte. El primer
  reporte sale cuando estén cargados, no antes.
</div>
{% endif %}
<table>
  {% for c in competidores %}
  <tr>
    <th>{{ c["nombre"] }}</th>
    <td>
      {% if c["meta_pagina_url"] %}{{ c["meta_pagina_url"] }}<br>{% endif %}
      {% if c["meta_consulta"] and not c["meta_pagina_url"] %}Búsqueda: {{ c["meta_consulta"] }}<br>{% endif %}
      {% if c["google_dominio"] %}<span class="pill">{{ c["google_dominio"] }}</span>{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>

{% if verificaciones %}
<h2>Verificación</h2>
<table>
  {% for v in verificaciones %}
  <tr>
    <th>{{ v.competidor }} · {{ v.plataforma }}</th>
    <td>
      {% if v.error %}No se pudo verificar ahora
      {% elif v.encontrados %}{{ v.encontrados }} anuncios activos
      {% else %}Sin anuncios activos en este momento{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>
<div class="nota">
  Un competidor sin anuncios activos no va a aparecer en su reporte hasta que
  vuelva a pautar. Si alguno le sorprende, escríbanos antes de confirmar.
</div>
{% endif %}

<h2>Confirmar</h2>
{% if simulado %}
<form method="post" action="/checkout/{{ cliente['id'] }}/confirmar">
  <input type="hidden" name="t" value="{{ firma }}">
  <button class="btn" type="submit">Confirmar (simulado)</button>
</form>
{% elif paddle and paddle.faltan %}
{# Mejor no mostrar el botón que abrir un checkout que cobra y no activa:
   sin el secreto del webhook el pago entra y nadie se entera. #}
<div class="nota">
  El cobro todavía no está disponible. Escríbanos y le activamos la cuenta a
  mano; no se le cobró nada.
</div>
{% elif paddle and paddle.precio %}
<p><button class="btn" type="button" id="pagar">Pagar con Paddle</button></p>
<div class="nota">
  El pago lo procesa Paddle, que además le emite la factura. Su cuenta se
  activa apenas Paddle nos confirma el cobro; no hace falta que nos escriba.
</div>
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
<script>
  // El entorno se fija antes de Initialize. En sandbox nada cobra de verdad.
  {% if paddle.entorno == "sandbox" %}Paddle.Environment.set("sandbox");{% endif %}
  Paddle.Initialize({ token: {{ paddle.token|tojson }} });
  document.getElementById("pagar").addEventListener("click", function () {
    Paddle.Checkout.open({
      items: [{ priceId: {{ paddle.precio|tojson }}, quantity: 1 }],
      customer: { email: {{ paddle.email|tojson }} },
      // Vuelve en el webhook: es lo que dice de qué cliente es el pago.
      customData: {{ paddle.custom_data|tojson }},
      settings: {
        displayMode: "overlay",
        locale: "es",
        // Se arma en el navegador para que salga con el dominio y el https
        // con que la persona entró, sin depender de cómo vea el servidor el
        // proxy de Railway.
        successUrl: window.location.origin + "/gracias/{{ cliente['id'] }}?t={{ firma }}"
      }
    });
  });
</script>
{% else %}
<div class="nota">Falta configurar el precio de este plan en Paddle.</div>
{% endif %}

{% endblock %}
