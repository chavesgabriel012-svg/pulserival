{% extends "_base.html.j2" %}
{% block titulo %}Confirmar — {{ marca }}{% endblock %}
{% block cabeza %}
<style>
  /* La forma de pago. El anual no es otro plan: es pagar el mismo de una vez,
     y por eso aparece recien aca. Se destaca con el borde y el ahorro en
     plata, sin preseleccionarlo: elegirlo tiene que ser una decision, no
     algo que se paso por alto. */
  .formas { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:0 0 8px; }
  .forma { position:relative; display:block; cursor:pointer; background:var(--blanco);
           border:1.5px solid var(--linea); border-radius:var(--radio);
           padding:20px 20px 18px; transition:border-color .2s, box-shadow .2s; }
  .forma:hover { border-color:var(--piedra); }
  .forma input { position:absolute; opacity:0; pointer-events:none; }
  .forma .cabeza-forma { display:flex; align-items:center; gap:10px; margin:0 0 10px; }
  .forma .marca-radio { width:18px; height:18px; border-radius:50%; flex:none;
                        border:1.5px solid var(--piedra); display:grid; place-items:center; }
  .forma .marca-radio:after { content:""; width:8px; height:8px; border-radius:50%;
                              background:var(--pulso); transform:scale(0);
                              transition:transform .15s; }
  .forma .nombre-forma { font-family:var(--display); font-weight:700; font-size:16px; }
  .forma .monto { font-family:var(--display); font-size:34px; font-weight:700;
                  letter-spacing:-.03em; line-height:1.05; margin:0 0 4px; }
  .forma .monto span { font-family:var(--cuerpo); font-size:15px; font-weight:400;
                       color:var(--gris-texto); letter-spacing:0; }
  .forma .explica { font-size:14.5px; color:var(--gris-texto); margin:0; line-height:1.45; }
  .forma.anual { border-color:var(--pulso); }
  .forma .ahorro { position:absolute; top:-11px; right:16px; background:var(--pulso);
                   color:var(--blanco); font-family:var(--display); font-size:12px;
                   letter-spacing:.1em; text-transform:uppercase; padding:4px 10px;
                   border-radius:3px; }
  .forma .ahorro-linea { color:var(--pulso-texto); font-weight:600; }
  .forma:has(input:checked) { border-color:var(--tinta);
                              box-shadow:0 0 0 1px var(--tinta); }
  .forma.anual:has(input:checked) { border-color:var(--pulso);
                                    box-shadow:0 0 0 1px var(--pulso); }
  .forma input:checked + .cabeza-forma .marca-radio { border-color:var(--tinta); }
  .forma input:checked + .cabeza-forma .marca-radio:after { transform:scale(1); }
  .forma input:focus-visible + .cabeza-forma .marca-radio {
    outline:2px solid var(--pulso); outline-offset:2px; }
  .total { font-family:var(--display); font-size:15px; margin:16px 0 18px; }
  .total strong { font-size:18px; }
  @media (max-width:560px) { .formas { grid-template-columns:1fr; gap:18px; } }
  /* La barra de pasos del formulario, con el ultimo (el pago) marcado. */
  .barra-pasos { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0;
                 margin:0 0 28px; }
  .barra-pasos li { display:inline-flex; align-items:center; gap:8px; font-family:var(--display);
                    font-size:13.5px; font-weight:500; color:var(--piedra);
                    padding:7px 13px 7px 7px; border-radius:100px; background:var(--blanco);
                    border:1px solid var(--linea); }
  .barra-pasos .n { display:inline-flex; align-items:center; justify-content:center;
                    width:22px; height:22px; border-radius:50%; background:var(--linea);
                    color:var(--gris-texto); font-family:var(--display); font-size:12px; }
  .barra-pasos li.hecho .n { background:var(--tinta); color:var(--papel); }
  .barra-pasos li.actual { border-color:var(--pulso); color:var(--tinta); }
  .barra-pasos li.actual .n { background:var(--pulso); color:var(--blanco); }
</style>
{% endblock %}
{% block contenido %}

{% if simulado %}
<div class="aviso">
  <strong>Cobro simulado</strong><br>
  Esta pantalla todavía no cobra. Confirmar acá activa la cuenta sin mover
  plata: sirve para probar el flujo completo antes de conectar la pasarela.
</div>
{% endif %}

{% if aplicar and aplicar.pasos %}
<ol class="barra-pasos" aria-label="Paso {{ aplicar.pasos|length }} de {{ aplicar.pasos|length }}">
  {% for p in aplicar.pasos %}
  <li class="{{ 'actual' if loop.last else 'hecho' }}"><span class="n">{{ loop.index }}</span>{{ p.corto }}</li>
  {% endfor %}
</ol>
{% endif %}
<h1>{{ cliente["nombre_empresa"] }}</h1>
<p>Revise que esté todo bien antes de confirmar.</p>

<h2>Su plan</h2>
<table>
  <tr><th>Plan</th><td>{{ plan.nombre or cliente["plan"] }}</td></tr>
  {% if not formas %}
  <tr><th>Precio</th><td>
    {% if ciclo and ciclo.cobro_texto %}{{ ciclo.cobro_texto }}
      {%- if ciclo.equivale_mes_usd %} (equivale a ${{ '%g' % ciclo.equivale_mes_usd }} al mes){% endif %}
    {% elif precio %}${{ '%g' % precio }} por mes{% elif precio == 0 %}Sin costo{% else %}A convenir{% endif %}
  </td></tr>
  {% endif %}
  <tr><th>Cadencia</th><td>
    {% if cliente["cadencia_dias"] %}Cada {{ cliente["cadencia_dias"] }} días
    {% else %}{{ plan.cadencia_texto or cliente["periodicidad"] }}{% endif %}
  </td></tr>
  <tr><th>Reporte a</th><td>{{ cliente["contacto_email"] }}</td></tr>
</table>

<h2>Competidores que vamos a seguir</h2>
{% if not competidores %}
<div class="nota">
  No nos indicó competidores: los identificamos nosotros a partir de su
  industria, y en su reporte le decimos a quiénes seguimos.
</div>
{% endif %}
<table>
  {% for c in competidores %}
  <tr>
    <th>{{ c["nombre"] }}</th>
    <td>
      {% if c["meta_pagina_url"] %}{{ c["meta_pagina_url"] }}<br>{% endif %}
      {% if c["meta_consulta"] and not c["meta_pagina_url"] %}Búsqueda: {{ c["meta_consulta"] }}<br>{% endif %}
      {% if c["google_dominio"] %}<span class="pill">{{ c["google_dominio"] }}</span>{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>

{% if verificaciones %}
<h2>Verificación</h2>
<table>
  {% for v in verificaciones %}
  <tr>
    <th>{{ v.competidor }} · {{ v.plataforma }}</th>
    <td>
      {% if v.error %}No se pudo verificar ahora
      {% elif v.encontrados %}{{ v.encontrados }} anuncios activos
      {% else %}Sin anuncios activos en este momento{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>
<div class="nota">
  Un competidor sin anuncios activos no va a aparecer en su reporte hasta que
  vuelva a pautar. Si alguno le sorprende, escríbanos{% if correo_soporte %} a <a href="mailto:{{ correo_soporte }}">{{ correo_soporte }}</a>{% endif %} antes de confirmar.
</div>
{% endif %}

{% macro elegir_forma() %}
{% if formas %}
<h2>Cómo prefiere pagar</h2>
<div class="formas" role="radiogroup" aria-label="Cómo prefiere pagar">
  {% for f in formas %}
  <label class="forma{% if f.ahorro_usd %} anual{% endif %}">
    {% if f.ahorro_usd %}<span class="ahorro">Ahorra ${{ '%g' % f.ahorro_usd }}</span>{% endif %}
    <input type="radio" name="ciclo" value="{{ f.clave }}" data-monto="{{ '%g' % f.precio_usd }}"
           {% if f.clave == ciclo_actual %}checked{% endif %}>
    <span class="cabeza-forma"><span class="marca-radio" aria-hidden="true"></span>
      <span class="nombre-forma">{{ f.titulo }}</span></span>
    <p class="monto">${{ '%g' % f.precio_usd }}<span> / {{ 'año' if f.clave == 'anual' else 'mes' }}</span></p>
    <p class="explica">
      {%- if f.equivale_mes_usd %}<span class="ahorro-linea">Le queda en ${{ '%g' % f.equivale_mes_usd }} al mes.</span>
      Un solo cobro al año, y se renueva solo.
      {%- else %}Se cobra cada mes. Puede cancelar cuando quiera.{% endif -%}
    </p>
  </label>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% if simulado %}
<form method="post" action="/checkout/{{ cliente['id'] }}/confirmar">
  {{ elegir_forma() }}
  <h2>Confirmar</h2>
  <input type="hidden" name="t" value="{{ firma }}">
  <button class="btn" type="submit">Confirmar (simulado)</button>
</form>
{% elif paddle and paddle.faltan %}
{# Mejor no mostrar el botón que abrir un checkout que cobra y no activa:
   sin el secreto del webhook el pago entra y nadie se entera. #}
<h2>Confirmar</h2>
<div class="nota">
  El cobro todavía no está disponible. Escríbanos{% if correo_soporte %} a <a href="mailto:{{ correo_soporte }}">{{ correo_soporte }}</a>{% endif %} y le activamos
  la cuenta a mano; no se le cobró nada.
</div>
{% elif paddle and paddle.precios %}
{{ elegir_forma() }}
<h2>Confirmar</h2>
<p><button class="btn" type="button" id="pagar">Pagar con Paddle</button></p>
<div class="nota">
  El pago lo procesa Paddle, que además le emite la factura. Su cuenta se
  activa apenas Paddle nos confirma el cobro; no hace falta que nos escriba.
</div>
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
<script>
  // El entorno se fija antes de Initialize. En sandbox nada cobra de verdad.
  {% if paddle.entorno == "sandbox" %}Paddle.Environment.set("sandbox");{% endif %}
  Paddle.Initialize({ token: {{ paddle.token|tojson }} });
  // Un precio de Paddle por forma de pago. El que se cobra es el de la
  // opción marcada; el webhook después anota en el cliente cuál fue.
  var PRECIOS = {{ paddle.precios|tojson }};
  var boton = document.getElementById("pagar");
  function elegida() {
    var marcada = document.querySelector('input[name="ciclo"]:checked');
    return marcada ? marcada : null;
  }
  function rotular() {
    var m = elegida();
    boton.textContent = m ? "Pagar $" + m.getAttribute("data-monto") + " con Paddle"
                          : "Pagar con Paddle";
  }
  document.querySelectorAll('input[name="ciclo"]').forEach(function (r) {
    r.addEventListener("change", rotular);
  });
  rotular();
  boton.addEventListener("click", function () {
    var m = elegida();
    var precio = m ? PRECIOS[m.value] : PRECIOS[{{ ciclo_actual|tojson }}];
    Paddle.Checkout.open({
      items: [{ priceId: precio, quantity: 1 }],
      customer: { email: {{ paddle.email|tojson }} },
      // Vuelve en el webhook: es lo que dice de qué cliente es el pago.
      customData: {{ paddle.custom_data|tojson }},
      settings: {
        displayMode: "overlay",
        locale: "es",
        // Se arma en el navegador para que salga con el dominio y el https
        // con que la persona entró, sin depender de cómo vea el servidor el
        // proxy de Railway.
        successUrl: window.location.origin + "/gracias/{{ cliente['id'] }}?t={{ firma }}"
      }
    });
  });
</script>
{% else %}
<h2>Confirmar</h2>
<div class="nota">Falta configurar el precio de este plan en Paddle.</div>
{% endif %}

{% endblock %}
