<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titulo %}{{ marca }}{% endblock %}</title>
<style>
  :root { --negro:#000; --gris:#6b6b6b; --linea:#d4d4d4; --suave:#f4f4f4; }
  * { box-sizing:border-box; }
  body { margin:0; background:#fff; color:#1b1b1b; line-height:1.6;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .env { max-width:760px; margin:0 auto; padding:0 24px; }
  a { color:var(--negro); }
  header { background:var(--negro); padding:18px 0; }
  header img { display:block; height:24px; width:auto; }
  h1 { font-size:28px; line-height:1.25; margin:0 0 16px; letter-spacing:-.3px; }
  h2 { font-size:13px; text-transform:uppercase; letter-spacing:1.4px; margin:36px 0 18px;
       padding-bottom:8px; border-bottom:2px solid var(--negro); display:inline-block; }
  .cuerpo { padding:56px 0 72px; }
  .btn { display:inline-block; background:var(--negro); color:#fff; text-decoration:none;
    padding:14px 26px; font-weight:600; font-size:15px; border:2px solid var(--negro);
    cursor:pointer; font-family:inherit; }
  .btn:hover { background:#fff; color:var(--negro); }
  .btn.alt { background:#fff; color:var(--negro); }
  .nota { background:var(--suave); padding:16px 18px; font-size:14px; color:#3a3a3a;
          border-left:3px solid var(--negro); margin:24px 0; }
  .aviso { border:2px solid var(--negro); padding:16px 18px; font-size:14px; margin:0 0 28px; }
  .aviso strong { text-transform:uppercase; letter-spacing:1px; font-size:12px; }
  table { width:100%; border-collapse:collapse; font-size:15px; }
  td, th { text-align:left; padding:10px 0; border-bottom:1px solid #ededed; vertical-align:top; }
  th { width:40%; color:var(--gris); font-weight:600; font-size:13px; }
  .pill { font-size:12px; color:var(--gris); }
  footer { background:var(--negro); color:#b0b0b0; padding:24px 0; font-size:13px; margin-top:48px; }
</style>
</head>
<body>
<header><div class="env">
  {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="{{ marca }}">
  {% else %}<span style="color:#fff;font-weight:600;letter-spacing:1.2px;">{{ marca }}</span>{% endif %}
</div></header>
<div class="env cuerpo">{% block contenido %}{% endblock %}</div>
<footer><div class="env">{{ marca }}{% if dominio %} · {{ dominio }}{% endif %}</div></footer>
</body>
</html>
