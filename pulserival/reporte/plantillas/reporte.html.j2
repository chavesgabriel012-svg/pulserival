<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ asunto }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;">
  <div style="display:none;max-height:0;overflow:hidden;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:28px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
             style="max-width:660px;background:#ffffff;border:1px solid #d4d4d4;
                    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">

        <!-- encabezado -->
        <tr><td style="background:#000000;padding:18px 30px;">
          <table role="presentation" width="100%"><tr>
            <td>
              {% if logo_data_uri %}
              <img src="{{ logo_data_uri }}" alt="{{ marca | default('PulseRival') }}"
                   height="22" style="display:block;height:22px;width:auto;border:0;">
              {% else %}
              <span style="color:#ffffff;font-size:17px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;">
                {{ marca | default('PulseRival') }}
              </span>
              {% endif %}
            </td>
            <td align="right" style="color:#b0b0b0;font-size:12px;">{{ periodo_fin }}</td>
          </tr></table>
        </td></tr>

        <!-- título -->
        <tr><td style="padding:30px 30px 0;">
          <div style="font-size:22px;font-weight:600;color:#000000;line-height:1.3;">
            Competencia de {{ cliente }}
          </div>
          <div style="font-size:13px;color:#6b6b6b;margin-top:7px;">
            Del {{ periodo_inicio }} al {{ periodo_fin }}
            {%- if competidores %} · {{ competidores | length }} competidores{% endif %}
          </div>
        </td></tr>

        <!-- cifras -->
        {% if conteo %}
        <tr><td style="padding:24px 30px 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                 style="border-top:2px solid #000000;border-bottom:1px solid #d4d4d4;">
            <tr>
              {% for etiqueta, valor in [('Nuevos', conteo.nuevo), ('Cambiaron', conteo.cambiado),
                                          ('Se apagaron', conteo.pausado), ('Siguen', conteo.continua)] %}
              <td style="padding:16px 6px;text-align:center;{% if not loop.last %}border-right:1px solid #e4e4e4;{% endif %}">
                <div style="font-size:28px;font-weight:600;color:#000000;line-height:1;">{{ valor }}</div>
                <div style="font-size:10px;color:#6b6b6b;text-transform:uppercase;letter-spacing:.8px;margin-top:7px;">{{ etiqueta }}</div>
              </td>
              {% endfor %}
            </tr>
          </table>
        </td></tr>
        {% endif %}

        <!-- comparativo -->
        {% if senales %}
        <tr><td style="padding:26px 30px 0;">
          <div style="font-size:15px;font-weight:600;color:#000000;margin-bottom:10px;">
            Comparativo de actividad
          </div>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                 style="border-collapse:collapse;font-size:12px;">
            <tr>
              <th align="left"  style="padding:8px 8px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Competidor</th>
              <th align="left"  style="padding:8px 6px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Plataforma</th>
              <th align="right" style="padding:8px 6px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Mensajes</th>
              <th align="right" style="padding:8px 6px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Piezas</th>
              <th align="right" style="padding:8px 6px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Nuevos</th>
              <th align="right" style="padding:8px 8px;color:#000000;font-weight:600;border-bottom:1.5px solid #000000;">Días</th>
            </tr>
            {% for f in senales %}
            <tr>
              <td style="padding:9px 8px;border-bottom:1px solid #e4e4e4;color:#000000;">{{ f.competidor }}</td>
              <td style="padding:9px 6px;border-bottom:1px solid #e4e4e4;color:#6b6b6b;">{{ 'Meta' if f.plataforma == 'meta' else 'Google' }}</td>
              <td align="right" style="padding:9px 6px;border-bottom:1px solid #e4e4e4;color:#000000;">{{ f.mensajes }}</td>
              <td align="right" style="padding:9px 6px;border-bottom:1px solid #e4e4e4;color:#4a4a4a;">{{ f.piezas }}</td>
              <td align="right" style="padding:9px 6px;border-bottom:1px solid #e4e4e4;color:#000000;font-weight:{{ '600' if f.nuevos else '400' }};">{{ f.nuevos }}</td>
              <td align="right" style="padding:9px 8px;border-bottom:1px solid #e4e4e4;color:#4a4a4a;">{{ f.dias_mensaje_mas_viejo if f.dias_mensaje_mas_viejo is not none else '—' }}</td>
            </tr>
            {% endfor %}
          </table>
          <div style="font-size:11px;color:#8a8a8a;margin-top:8px;line-height:1.5;">
            Mensajes: avisos distintos al aire. Piezas: veces que repite cada aviso.
            Días: antigüedad del aviso más viejo que mantiene activo.
          </div>
        </td></tr>
        {% endif %}

        <!-- análisis -->
        <tr><td style="padding:8px 30px 4px;font-size:15px;color:#2b2b2b;">
          {{ cuerpo_html | safe }}
        </td></tr>

        <!-- detalle por competidor -->
        {% if por_competidor %}
        <tr><td style="padding:26px 30px 0;">
          <div style="font-size:15px;font-weight:600;color:#000000;border-top:2px solid #000000;padding-top:18px;">
            Detalle de anuncios
          </div>
          <div style="font-size:11px;color:#8a8a8a;margin-top:5px;">
            Cada anuncio enlaza a su ficha en la biblioteca pública de la plataforma.
          </div>

          {% for g in por_competidor %}
          <div style="margin-top:22px;">
            <div style="font-size:14px;font-weight:600;color:#000000;border-bottom:1px solid #000000;padding-bottom:6px;">
              {{ g.competidor }} — {{ g.total }} anuncio{{ '' if g.total == 1 else 's' }}{% if g.piezas > g.total %} en {{ g.piezas }} piezas{% endif %}
            </div>

            {% for plataforma, etiqueta in [('meta', 'Meta (Facebook e Instagram)'), ('google', 'Google')] %}
            {% if g[plataforma] %}
            <div style="font-size:12px;font-weight:600;color:#4a4a4a;margin:14px 0 2px;text-transform:uppercase;letter-spacing:.6px;">
              {{ etiqueta }} · {{ g[plataforma] | length }}
            </div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:12px;color:#4a4a4a;">
              {% for a in g[plataforma] %}
              <tr>
                {% if miniaturas %}
                <td style="padding:10px 12px 10px 0;border-bottom:1px solid #ededed;vertical-align:top;width:70px;">
                  {% if a.creativo_url %}
                  <img src="{{ a.creativo_url }}" width="58" alt=""
                       style="width:58px;border:1px solid #e4e4e4;display:block;">
                  {% else %}
                  <div style="width:58px;height:44px;border:1px solid #e4e4e4;background:#fafafa;"></div>
                  {% endif %}
                </td>
                {% endif %}
                <td style="padding:10px 0;border-bottom:1px solid #ededed;vertical-align:top;line-height:1.55;">
                  <span style="color:#000000;font-weight:600;">{{ a.referencia }}</span>
                  <span style="color:#8a8a8a;">
                    {{ a.clasificacion }}
                    {%- if a.variantes and a.variantes > 1 %} · {{ a.variantes }} piezas{% endif %}
                    {%- if a.tipo_creativo %} · {{ a.tipo_creativo }}{% endif %}
                    {%- if a.fecha_inicio %} · desde {{ a.fecha_inicio }}{% endif %}
                  </span><br>
                  {% if a.sin_texto %}
                  <span style="color:#8a8a8a;">La plataforma no publica el texto de este anuncio.</span>
                  {% else %}
                  {{ (a.titulo or a.texto or '')[:180] }}{% if (a.titulo or a.texto or '')|length > 180 %}…{% endif %}
                  {% endif %}
                  {% if a.url_anuncio %}
                  <br><a href="{{ a.url_anuncio }}" style="color:#000000;text-decoration:underline;">Ver en la fuente</a>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
              {% if g[plataforma ~ '_no_listados'] %}
              <tr><td {% if miniaturas %}colspan="2"{% endif %}
                      style="padding:10px 0;border-bottom:1px solid #ededed;color:#8a8a8a;">
                y {{ g[plataforma ~ '_no_listados'] }} anuncio{{ '' if g[plataforma ~ '_no_listados'] == 1 else 's' }}
                más de este competidor en la plataforma, incluidos en los conteos del comparativo.
              </td></tr>
              {% endif %}
            </table>
            {% endif %}
            {% endfor %}
          </div>
          {% endfor %}
        </td></tr>
        {% endif %}

        <!-- nota al pie -->
        <tr><td style="padding:26px 30px 24px;">
          <div style="border-top:1px solid #d4d4d4;padding-top:14px;font-size:11px;color:#8a8a8a;line-height:1.7;">
            Fuentes: Biblioteca de Anuncios de Meta y Centro de Transparencia de Anuncios
            de Google, ambas públicas. Revisadas de forma automática para cada competidor
            y comparadas contra los periodos anteriores. Un anuncio que deja de aparecer
            dejó de publicarse en la biblioteca; no implica que haya fracasado. Las
            plataformas no publican inversión, alcance ni clics de los anuncios
            comerciales, de modo que este reporte no los incluye.
          </div>
        </td></tr>

        <!-- pie -->
        <tr><td style="background:#000000;padding:14px 30px;font-size:11px;color:#b0b0b0;line-height:1.6;">
          {{ marca | default('PulseRival') }} · Preparado para {{ cliente }}
          {% if contacto_remitente %}<br>{{ contacto_remitente }}{% endif %}
          {% if enlace_baja %}<br><a href="{{ enlace_baja }}" style="color:#8a8a8a;">Darse de baja</a>{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
